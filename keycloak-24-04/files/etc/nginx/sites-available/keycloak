server {
    listen 80;
    server_name _;

    # ACME HTTP-01 (Certbot) — keep reachable on plain HTTP
    location ~ /.well-known {
        allow all;
    }

    # Do not terminate admin traffic on plain HTTP: send browsers to Keycloak HTTPS.
    # After Certbot adds TLS on 443, use the hostname URL; :8443 remains the container HTTPS port.
    location / {
        return 302 https://$host:8443$request_uri;
    }
}

server {
    listen 9001;
    server_name _;

    location ~ /.well-known {
        allow all;
    }

    location / {
        return 302 https://$host:9000$request_uri;
    }
}
