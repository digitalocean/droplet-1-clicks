#!/bin/bash

set -e

set -a
source /etc/environment 2>/dev/null || true
set +a

# Remove the ssh force logout command
sed -e '/Match User root/d' \
    -e '/.*ForceCommand.*droplet.*/d' \
    -i /etc/ssh/sshd_config

systemctl restart ssh

# Create OpenCode directories
mkdir -p /root/.config/opencode
mkdir -p /root/.local/share/opencode

chmod +x /opt/apply-inference-from-env.sh

if /opt/apply-inference-from-env.sh; then
    echo "Serverless Inference pre-configured from droplet environment."
    echo "Skipping setup wizard on first login."
elif ! grep -q '/opt/setup-opencode.sh' /root/.bashrc 2>/dev/null; then
    cat >> /root/.bashrc <<EOM
/opt/setup-opencode.sh
EOM

    # Startup scripts can write MODEL_ACCESS_KEY after this script; retry after cloud-init.
    cat > /opt/retry-apply-inference-after-cloud-init.sh <<'EOF'
#!/bin/bash
set -a
source /etc/environment 2>/dev/null || true
set +a
if /opt/apply-inference-from-env.sh; then
    sed -i '/\/opt\/setup-opencode\.sh/d' /root/.bashrc 2>/dev/null || true
fi
EOF
    chmod +x /opt/retry-apply-inference-after-cloud-init.sh

    cat > /etc/systemd/system/opencode-apply-inference.service <<'EOF'
[Unit]
Description=Apply OpenCode Serverless Inference config after cloud-init user-data
After=cloud-init.service
ConditionPathExists=!/root/.opencode_setup_complete

[Service]
Type=oneshot
ExecStart=/opt/retry-apply-inference-after-cloud-init.sh

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable opencode-apply-inference.service
    systemctl start opencode-apply-inference.service || true
fi

# Create a getting started file for first-time users
cat > /root/opencode_info.txt << 'EOF'
================================================================================
OpenCode 1-Click Droplet - Getting Started
================================================================================

OpenCode is an AI coding agent that runs in your terminal, pre-configured to
use DigitalOcean Serverless Inference.

PRE-CONFIGURED MODELS (via DigitalOcean Serverless Inference):

  digitalocean/ (default: MiniMax M2.5):
    GPT-5.2, GPT-5, GPT-4.1, o3, DeepSeek R1 70B, Qwen3 32B,
    Llama 3.3 70B, Kimi K2.5, glm-5, MiniMax M2.5,
    Claude Opus 4.6, Opus 4.5, Sonnet 4.5, Sonnet 4

AUTO-CONFIGURATION (optional):

  If MODEL_ACCESS_KEY (and optionally INFERENCE_MODEL) are passed as droplet
  environment variables, OpenCode configures Serverless Inference automatically on first
  boot and skips the interactive setup wizard.

NEXT STEPS:

1. If Serverless Inference was not auto-configured, the setup wizard runs on first login
   to configure your DigitalOcean model access key. To create one:
     https://cloud.digitalocean.com/gen-ai
     Navigate to API Keys > Model Access Keys

2. Run OpenCode:
   cd /path/to/your/project
   opencode

3. Helper commands:
   Check version:    /opt/opencode-version.sh
   Update OpenCode:  /opt/update-opencode.sh
   Re-run setup:     /opt/setup-opencode.sh

Other providers: use /connect inside OpenCode to add your own API keys
                 for Anthropic, OpenAI, Google, and 70+ more providers.

Configuration:  /root/.config/opencode/opencode.json
Auth:           /root/.local/share/opencode/auth.json
Inference env:  /opt/opencode.env

For documentation: https://opencode.ai/docs

INFERENCE USAGE (DigitalOcean Serverless Inference):

  Chat responses may include usage fields (including names like cache read/write).
  On the Serverless Inference OpenAI-compatible endpoint those cache-related values are often
  zero across models; rely on DigitalOcean billing and product docs for what is
  actually charged. For other providers added via /connect, usage follows each
  vendor's API.

================================================================================
EOF

chmod 600 /root/opencode_info.txt

echo "OpenCode first-boot initialization complete!"
echo "Getting started info saved to /root/opencode_info.txt"
