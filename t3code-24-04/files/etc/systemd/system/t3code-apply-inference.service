[Unit]
Description=Apply T3 Code Serverless Inference config after cloud-init user-data
After=cloud-init.service
ConditionPathExists=!/var/lib/digitalocean/t3code-inference-configured

[Service]
Type=oneshot
ExecStart=/opt/retry-apply-inference-after-cloud-init.sh

[Install]
WantedBy=multi-user.target
