{
  "variables": {
    "do_api_token": "{{env `DIGITALOCEAN_API_TOKEN`}}",
    "image_name": "t3code-24-04-snapshot-{{timestamp}}",
    "apt_packages": "apt-transport-https ca-certificates curl software-properties-common git jq unzip gnupg fail2ban ufw bubblewrap socat ripgrep xz-utils libatomic1",
    "application_name": "T3 Code",
    "application_version": "latest",
    "node_version": "latest",
    "claude_version": "latest",
    "codex_version": "latest",
    "cursor_version": "latest",
    "grok_version": "latest",
    "opencode_version": "latest",
    "pi_version": "latest",
    "fx_version": "latest",
    "antigravity_version": "latest"
  },
  "sensitive-variables": ["do_api_token"],
  "builders": [
    {
      "type": "digitalocean",
      "api_token": "{{user `do_api_token`}}",
      "image": "ubuntu-24-04-x64",
      "region": "ams3",
      "size": "s-2vcpu-4gb",
      "ssh_username": "root",
      "snapshot_name": "{{user `image_name`}}"
    }
  ],
  "provisioners": [
    {"type": "shell", "inline": ["cloud-init status --wait"]},
    {"type": "file", "source": "common/files/var/", "destination": "/var/"},
    {"type": "file", "source": "t3code-24-04/files/etc/", "destination": "/etc/"},
    {"type": "file", "source": "t3code-24-04/files/opt/", "destination": "/opt/"},
    {"type": "file", "source": "t3code-24-04/files/usr/local/bin/", "destination": "/usr/local/bin/"},
    {"type": "file", "source": "t3code-24-04/files/var/", "destination": "/var/"},
    {
      "type": "shell",
      "environment_vars": [
        "DEBIAN_FRONTEND=noninteractive",
        "LC_ALL=C",
        "LANG=en_US.UTF-8",
        "LC_CTYPE=en_US.UTF-8"
      ],
      "inline": [
        "apt -qqy update",
        "apt -qqy -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' full-upgrade",
        "apt -qqy -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' install {{user `apt_packages`}}",
        "apt-get -qqy clean"
      ]
    },
    {
      "type": "shell",
      "environment_vars": [
        "application_name={{user `application_name`}}",
        "application_version={{user `application_version`}}",
        "node_version={{user `node_version`}}",
        "claude_version={{user `claude_version`}}",
        "codex_version={{user `codex_version`}}",
        "cursor_version={{user `cursor_version`}}",
        "grok_version={{user `grok_version`}}",
        "opencode_version={{user `opencode_version`}}",
        "pi_version={{user `pi_version`}}",
        "fx_version={{user `fx_version`}}",
        "antigravity_version={{user `antigravity_version`}}",
        "DEBIAN_FRONTEND=noninteractive",
        "LC_ALL=C",
        "LANG=en_US.UTF-8",
        "LC_CTYPE=en_US.UTF-8"
      ],
      "scripts": [
        "t3code-24-04/scripts/010-t3code.sh",
        "common/scripts/014-ufw-http.sh",
        "common/scripts/018-force-ssh-logout.sh",
        "common/scripts/020-application-tag.sh",
        "t3code-24-04/scripts/021-record-resolved-version.sh",
        "common/scripts/900-cleanup.sh"
      ]
    }
  ]
}
