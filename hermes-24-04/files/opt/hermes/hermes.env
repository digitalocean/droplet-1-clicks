# Hermes Agent 1-Click notes
#
# Hermes user:  hermes
# Hermes home:  /home/hermes/.hermes
# Workspace:    /home/hermes/workspace
#
# Configure providers with:
#   sudo -u hermes -H /home/hermes/.local/bin/hermes setup
# or:
#   hermes setup
#
# Provider keys are stored in /home/hermes/.hermes/.env by Hermes itself.
#
# DigitalOcean Serverless Inference preconfiguration (optional):
#   MODEL_ACCESS_KEY    Model access key (Inference > Manage in the control panel)
#   MODEL_ACCESS_MODEL  Inference model id from GET https://inference.do-ai.run/v1/models
#
# On first boot, /opt/hermes/apply-inference-from-env.sh reads /etc/environment
# first, then this file. If MODEL_ACCESS_KEY is set, it lists models from
# the inference API, configures Hermes for DigitalOcean Serverless Inference,
# and skips the interactive first-login setup wizard. If MODEL_ACCESS_MODEL is
# empty, the first chat-capable model from that API list is used.
MODEL_ACCESS_KEY=
MODEL_ACCESS_MODEL=
