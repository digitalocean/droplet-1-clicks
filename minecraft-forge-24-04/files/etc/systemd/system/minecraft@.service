[Unit]
Description=Minecraft Forge Droplet Server
After=network.target

[Service]
WorkingDirectory=/opt/minecraft

Type=forking

PrivateUsers=true

User=minecraft
Group=minecraft

ProtectSystem=full

ProtectHome=true

ProtectKernelTunables=true

ProtectKernelModules=true

ProtectControlGroups=true

Environment="SHUTDOWN_DELAY=5" "POST_SHUTDOWN_DELAY=10"

# Modern Forge boots via run.sh (reads user_jvm_args.txt). Heap size is set
# on first boot in /opt/minecraft/user_jvm_args.txt from available RAM.
# Instance name minecraft@<MB> is kept for MOTD/status compatibility only.
ExecStart=/bin/sh -c \
            '/usr/bin/screen -dmS minecraft \
                ./run.sh nogui'

ExecReload=/usr/bin/screen -p 0 -S minecraft -X eval 'stuff "reload"\\015'

ExecStop=/usr/bin/screen -p 0 -S minecraft -X eval 'stuff "say SERVER SHUTTING DOWN. Saving map..."\\015'
ExecStop=/bin/sh -c '/bin/sleep ${SHUTDOWN_DELAY}'
ExecStop=/usr/bin/screen -p 0 -S minecraft -X eval 'stuff "save-all"\\015'
ExecStop=/usr/bin/screen -p 0 -S minecraft -X eval 'stuff "stop"\\015'
ExecStop=/bin/sh -c '/bin/sleep ${POST_SHUTDOWN_DELAY}'

Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
