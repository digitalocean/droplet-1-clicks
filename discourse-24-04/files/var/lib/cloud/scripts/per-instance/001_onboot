#!/bin/bash
set -euo pipefail

# Scripts in this directory will be executed by cloud-init on the first boot of droplets
# created from your image. Items unique per instance (IP-dependent config, updates, etc.)
# should be done here.

unlock_ssh() {
  sed -e '/Match User root/d' \
      -e '/.*ForceCommand.*droplet.*/d' \
      -i /etc/ssh/sshd_config
  systemctl restart ssh
}
# Always remove the SSH ForceCommand lock, even if updates fail
trap unlock_ssh EXIT

# Refresh discourse_docker so first-login setup uses current installer scripts
cd /var/discourse
git pull

export DEBIAN_FRONTEND=noninteractive
apt-get update
UCF_FORCE_CONFFOLD=1 apt-get -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' -qqy upgrade
