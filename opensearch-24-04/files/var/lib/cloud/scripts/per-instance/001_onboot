#!/bin/bash
set -u

unlock_ssh() {
  sed -e '/Match User root/d' \
      -e '/.*ForceCommand.*droplet.*/d' \
      -i /etc/ssh/sshd_config || true
  systemctl restart ssh || true
}
# Always clear the first-boot SSH lock so a failed setup cannot strand the droplet.
trap unlock_ssh EXIT

generate_password() {
  # Meet OpenSearch complexity rules while staying friendly for URL userinfo
  # (avoid : @ / # ? & and other reserved URI / shell metacharacters)
  local upper=$(< /dev/urandom tr -dc 'A-Z' | head -c 1)
  local lower=$(< /dev/urandom tr -dc 'a-z' | head -c 1)
  local digit=$(< /dev/urandom tr -dc '0-9' | head -c 1)
  local special=$(< /dev/urandom tr -dc '*_=-' | head -c 1)
  local rest=$(< /dev/urandom tr -dc 'A-Za-z0-9*_=-' | head -c 12)
  echo "${upper}${lower}${digit}${special}${rest}" | fold -w1 | shuf | tr -d '\n'
}

ensure_apt_repos() {
  install -d -m 0755 /etc/apt/keyrings
  if [ ! -f /etc/apt/keyrings/opensearch.gpg ]; then
    curl -fsSL https://artifacts.opensearch.org/publickeys/opensearch-release.pgp \
      | gpg --dearmor --batch --yes -o /etc/apt/keyrings/opensearch.gpg
    chmod a+r /etc/apt/keyrings/opensearch.gpg
  fi
  if [ ! -f /etc/apt/keyrings/opensearch-release-keyring ]; then
    curl -fsSL https://artifacts.opensearch.org/publickeys/opensearch-release.pgp \
      | gpg --dearmor --batch --yes -o /etc/apt/keyrings/opensearch-release-keyring
    chmod a+r /etc/apt/keyrings/opensearch-release-keyring
  fi

  # Re-enable lists if a previous failed boot left them disabled
  if [ -f "/etc/apt/sources.list.d/opensearch-${repo_version}.list.disabled" ] \
    && [ ! -f "/etc/apt/sources.list.d/opensearch-${repo_version}.list" ]; then
    mv "/etc/apt/sources.list.d/opensearch-${repo_version}.list.disabled" \
      "/etc/apt/sources.list.d/opensearch-${repo_version}.list"
  fi
  if [ -f "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list.disabled" ] \
    && [ ! -f "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list" ]; then
    mv "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list.disabled" \
      "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list"
  fi

  if [ ! -f "/etc/apt/sources.list.d/opensearch-${repo_version}.list" ]; then
    echo "deb [signed-by=/etc/apt/keyrings/opensearch.gpg] https://artifacts.opensearch.org/releases/bundle/opensearch/${repo_version}/apt stable main" \
      > "/etc/apt/sources.list.d/opensearch-${repo_version}.list"
  fi
  if [ ! -f "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list" ]; then
    echo "deb [signed-by=/etc/apt/keyrings/opensearch-release-keyring] https://artifacts.opensearch.org/releases/bundle/opensearch-dashboards/${repo_version}/apt stable main" \
      > "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list"
  fi
}

install_from_deb() {
  local os_ver="$1"
  local osd_ver="$2"
  local tmp
  tmp=$(mktemp -d)
  echo "Falling back to direct .deb install for OpenSearch ${os_ver} + Dashboards ${osd_ver}"
  # Dashboards release can lag OpenSearch (e.g. OS 3.10.1 pairs with OSD 3.10.0)
  if ! curl -fsSL -o "${tmp}/opensearch.deb" \
    "https://artifacts.opensearch.org/releases/bundle/opensearch/${os_ver}/opensearch-${os_ver}-linux-x64.deb"; then
    echo "ERROR: failed to download opensearch ${os_ver} .deb" >&2
    rm -rf "${tmp}"
    return 1
  fi
  if ! curl -fsSL -o "${tmp}/opensearch-dashboards.deb" \
    "https://artifacts.opensearch.org/releases/bundle/opensearch-dashboards/${osd_ver}/opensearch-dashboards-${osd_ver}-linux-x64.deb"; then
    echo "ERROR: failed to download opensearch-dashboards ${osd_ver} .deb" >&2
    rm -rf "${tmp}"
    return 1
  fi

  # Password must be quoted — unquoted values with # truncate the command
  if ! env OPENSEARCH_INITIAL_ADMIN_PASSWORD="${admin_opensearch_pass}" \
    dpkg -i "${tmp}/opensearch.deb"; then
    apt-get install -f -y
    env OPENSEARCH_INITIAL_ADMIN_PASSWORD="${admin_opensearch_pass}" \
      dpkg -i "${tmp}/opensearch.deb" || { rm -rf "${tmp}"; return 1; }
  fi
  if ! dpkg -i "${tmp}/opensearch-dashboards.deb"; then
    apt-get install -f -y
    dpkg -i "${tmp}/opensearch-dashboards.deb" || { rm -rf "${tmp}"; return 1; }
  fi
  rm -rf "${tmp}"
}

source /root/packer_vars.sh
application_version=${APPLICATION_VERSION:?APPLICATION_VERSION missing from /root/packer_vars.sh}
# OpenSearch Dashboards often ships one patch behind (3.10.1 -> 3.10.0)
dashboards_version=${DASHBOARDS_VERSION:-${application_version}}
repo_version=${REPO_VERSION:-3.x}
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

# Generate password for OpenSearch admin user
admin_opensearch_pass=$(generate_password)

# Store the passwords securely
cat > /root/.digitalocean_passwords << EOM
admin_opensearch_password="${admin_opensearch_pass}"
EOM
chmod 600 /root/.digitalocean_passwords

# Install pinned OpenSearch + Dashboards (3.10.1+ ships Temurin 25.0.5.1+2 for CVE-2026-114938)
ensure_apt_repos
apt-get update
apt-get update --allow-releaseinfo-change || true

if ! env OPENSEARCH_INITIAL_ADMIN_PASSWORD="${admin_opensearch_pass}" \
  apt-get install -y "opensearch=${application_version}" "opensearch-dashboards=${dashboards_version}"; then
  echo "WARN: apt pin install failed for opensearch=${application_version} dashboards=${dashboards_version}; available packages:" >&2
  apt-cache madison opensearch opensearch-dashboards >&2 || true
  apt-cache policy opensearch opensearch-dashboards >&2 || true
  if ! install_from_deb "${application_version}" "${dashboards_version}"; then
    echo "ERROR: OpenSearch ${application_version} / Dashboards ${dashboards_version} install failed (apt and .deb fallback)" >&2
    exit 1
  fi
fi

installed_os=$(dpkg-query -W -f='${Version}' opensearch)
installed_osd=$(dpkg-query -W -f='${Version}' opensearch-dashboards)
case "${installed_os}" in
  "${application_version}"|"${application_version}"-*) ;;
  *)
    echo "ERROR: expected opensearch ${application_version}, got ${installed_os}" >&2
    exit 1
    ;;
esac
case "${installed_osd}" in
  "${dashboards_version}"|"${dashboards_version}"-*) ;;
  *)
    echo "ERROR: expected opensearch-dashboards ${dashboards_version}, got ${installed_osd}" >&2
    exit 1
    ;;
esac

export JAVA_HOME=/usr/share/opensearch/jdk

# Open API/Dashboards ports early (UFW default deny would block browsers until the end)
ufw allow 9200/tcp
ufw allow 5601/tcp

# Disable the OpenSearch repository to prevent automatic updates
if [ -f "/etc/apt/sources.list.d/opensearch-${repo_version}.list" ]; then
  mv "/etc/apt/sources.list.d/opensearch-${repo_version}.list" \
    "/etc/apt/sources.list.d/opensearch-${repo_version}.list.disabled"
fi
if [ -f "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list" ]; then
  mv "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list" \
    "/etc/apt/sources.list.d/opensearch-dashboards-${repo_version}.list.disabled"
fi

# Generate certificates (root CA, node, admin) — keys must be PKCS#8 for OpenSearch/Java
mkdir -p /etc/opensearch/certs
cd /etc/opensearch/certs

openssl genrsa -out root-ca-key-temp.pem 2048
openssl pkcs8 -inform PEM -outform PEM -in root-ca-key-temp.pem -topk8 -nocrypt -v1 PBE-SHA1-3DES -out root-ca.key
openssl req -new -x509 -sha256 -key root-ca.key -days 365 \
  -subj "/C=US/ST=State/L=City/O=Organization/OU=Unit/CN=example.com" \
  -addext 'basicConstraints = critical, CA:TRUE, pathlen:0' \
  -addext 'keyUsage = critical, keyCertSign, cRLSign' \
  -out root-ca.pem

openssl genrsa -out opensearch-key-temp.pem 2048
openssl pkcs8 -inform PEM -outform PEM -in opensearch-key-temp.pem -topk8 -nocrypt -v1 PBE-SHA1-3DES -out opensearch.key
openssl req -new -key opensearch.key \
  -subj "/C=US/ST=State/L=City/O=Organization/OU=Unit/CN=opensearch-node" \
  -out opensearch.csr
printf '%s\n' 'subjectAltName=DNS:localhost,IP:127.0.0.1' > opensearch.ext
openssl x509 -req -in opensearch.csr -CA root-ca.pem -CAkey root-ca.key -CAcreateserial \
  -out opensearch.pem -days 365 -sha256 -extfile opensearch.ext

openssl genrsa -out admin-key-temp.pem 2048
openssl pkcs8 -inform PEM -outform PEM -in admin-key-temp.pem -topk8 -nocrypt -v1 PBE-SHA1-3DES -out admin.key
openssl req -new -key admin.key \
  -subj "/C=US/ST=State/L=City/O=Organization/OU=SSL/CN=admin" \
  -out admin.csr
openssl x509 -req -in admin.csr -CA root-ca.pem -CAkey root-ca.key -CAcreateserial \
  -out admin.pem -days 365 -sha256

# DNs for opensearch.yml must match certificate subjects (RFC2253)
admin_dn=$(openssl x509 -subject -nameopt RFC2253 -noout -in admin.pem | sed 's/^subject=//')
node_dn=$(openssl x509 -subject -nameopt RFC2253 -noout -in opensearch.pem | sed 's/^subject=//')

rm -f ./*-temp.pem ./*.csr ./*.ext ./*.srl

chown -R opensearch:opensearch /etc/opensearch/certs
chmod 600 /etc/opensearch/certs/*

# Create the OpenSearch configuration file
cat <<EOF | tee /etc/opensearch/opensearch.yml > /dev/null
cluster.name: opensearch-cluster
node.name: \${HOSTNAME}
path.data: /var/lib/opensearch
path.logs: /var/log/opensearch
network.host: 0.0.0.0
http.port: 9200
discovery.seed_hosts: ["127.0.0.1"]
cluster.initial_cluster_manager_nodes: ["\${HOSTNAME}"]

# SSL/TLS configuration for REST API
plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: certs/opensearch.pem
plugins.security.ssl.http.pemkey_filepath: certs/opensearch.key
plugins.security.ssl.http.pemtrustedcas_filepath: certs/root-ca.pem

# SSL/TLS configuration for transport layer (node-to-node communication)
plugins.security.ssl.transport.pemcert_filepath: certs/opensearch.pem
plugins.security.ssl.transport.pemkey_filepath: certs/opensearch.key
plugins.security.ssl.transport.pemtrustedcas_filepath: certs/root-ca.pem
plugins.security.ssl.transport.enforce_hostname_verification: false

# Security settings (DNs must match cert subjects in RFC2253 order)
plugins.security.authcz.admin_dn:
  - "${admin_dn}"
plugins.security.nodes_dn:
  - "${node_dn}"
EOF

chmod 600 /etc/opensearch/opensearch.yml
chown opensearch:opensearch /etc/opensearch/opensearch.yml

# Create the OpenSearch Dashboards configuration file
cat <<EOF | tee /etc/opensearch-dashboards/opensearch_dashboards.yml > /dev/null
server.host: "0.0.0.0"
server.port: 5601
server.ssl.enabled: true
server.ssl.certificate: /etc/opensearch/certs/opensearch.pem
server.ssl.key: /etc/opensearch/certs/opensearch.key
opensearch.hosts: ["https://localhost:9200"]
opensearch.ssl.verificationMode: none
opensearch.username: "admin"
opensearch.password: "${admin_opensearch_pass}"
EOF

chmod 640 /etc/opensearch-dashboards/opensearch_dashboards.yml
chown opensearch-dashboards:opensearch-dashboards /etc/opensearch-dashboards/opensearch_dashboards.yml

# Add opensearch-dashboards user to opensearch group to access certificates
usermod -a -G opensearch opensearch-dashboards
chown opensearch:opensearch /etc/opensearch/certs/opensearch.pem
chown opensearch:opensearch /etc/opensearch/certs/opensearch.key
chmod 640 /etc/opensearch/certs/opensearch.pem
chmod 640 /etc/opensearch/certs/opensearch.key

# Remove demo certificates left by the package
rm -f /etc/opensearch/*.pem /etc/opensearch/*.key /etc/opensearch/*.crt

# Start OpenSearch with the generated config (restart in case the package auto-started)
systemctl enable opensearch
systemctl restart opensearch

# Wait until HTTPS is accepting connections before securityadmin (401 counts as up)
ready=0
for _ in $(seq 1 90); do
  code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 2 https://127.0.0.1:9200 || true)
  case "${code}" in
    200|401) ready=1; break ;;
  esac
  sleep 2
done
if [ "${ready}" -ne 1 ]; then
  echo "ERROR: OpenSearch did not become ready on :9200 within 180s" >&2
  journalctl -u opensearch -n 100 --no-pager >&2 || true
  exit 1
fi

# Initialize security config (timeout so a hung securityadmin cannot strand first boot)
if ! timeout 180 /usr/share/opensearch/plugins/opensearch-security/tools/securityadmin.sh \
    -cd /etc/opensearch/opensearch-security/ \
    -icl -nhnv \
    -cacert /etc/opensearch/certs/root-ca.pem \
    -cert /etc/opensearch/certs/admin.pem \
    -key /etc/opensearch/certs/admin.key; then
  echo "ERROR: securityadmin.sh failed or timed out" >&2
  journalctl -u opensearch -n 100 --no-pager >&2 || true
  exit 1
fi

chown -R opensearch:opensearch /etc/opensearch/opensearch-security
chmod 600 /etc/opensearch/opensearch-security/*

# Restart OpenSearch to apply security changes
systemctl restart opensearch

ready=0
for _ in $(seq 1 90); do
  code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 2 https://127.0.0.1:9200 || true)
  case "${code}" in
    200|401) ready=1; break ;;
  esac
  sleep 2
done
if [ "${ready}" -ne 1 ]; then
  echo "ERROR: OpenSearch did not become ready after securityadmin restart" >&2
  journalctl -u opensearch -n 100 --no-pager >&2 || true
  exit 1
fi

# Start OpenSearch Dashboards
systemctl enable opensearch-dashboards
systemctl restart opensearch-dashboards

# Confirm Dashboards is listening (best-effort; do not block SSH unlock)
for _ in $(seq 1 30); do
  code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 2 https://127.0.0.1:5601 || true)
  case "${code}" in
    200|302|401) break ;;
  esac
  sleep 2
done

echo "OpenSearch first-boot setup completed successfully."
