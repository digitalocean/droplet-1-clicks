# QM 1-Click environment (materialized to /srv/qm/.env on install).
#
# This single file is loaded into every QM container (core, web-ui, portal)
# the same way the upstream Helm chart's `secretEnv`/`env` blocks are injected
# into every pod via envFrom — each service simply ignores the keys it does
# not read. After changing anything here: /srv/qm/restart-qm.sh
#
# Re-run the interactive wizard any time with: sudo /etc/setup_wizard.sh

# --- Model provider (pick one; the setup wizard asks which) ---------------
# HARNESS=pi (below) works with either provider — core auto-picks a sensible
# default model for whichever one has a key set (claude-opus-5 / gpt-5.6-sol),
# no explicit model id needed.
MODEL_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys — only needed if MODEL_PROVIDER=openai
OPENAI_API_KEY=

# --- Sandbox backend (where agent turns actually run) -------------------
# QM's own docker CLI target refuses e2b, but core itself supports it fine —
# this compose file wires it directly, the same way qm-kubernetes/values.yml
# does. Sign up at https://e2b.dev (console.e2b.dev -> API Keys).
SANDBOX_BACKEND=e2b
E2B_API_KEY=
# Free/hobby e2b accounts cap sandbox timeout at 1h; raise this if the e2b
# account is upgraded to Pro (24h).
E2B_MAX_LIFETIME_SEC=3600
HARNESS=pi

# --- Org / admin ----------------------------------------------------------
ORG_ID=qm
# <email>:org_admin — without this the admin console is permanently
# unreachable, there is no in-product way to grant the first admin later.
ADMIN_GRANTS=
# Comma-separated; must include the ADMIN_GRANTS email.
AUTH_ALLOWED_EMAILS=
OIDC_ALLOWED_EMAILS=
# <email>:<scrypt-hash> — the only way to sign in on this droplet (no email
# transport is configured). Generated by the setup wizard; see README.md to
# add a real email/SSO provider instead.
AUTH_PASSWORD_USERS=

# --- Storage ---------------------------------------------------------------
SESSION_STORE=postgres
RUN_STORE=postgres
DATA_DIR=/data
PORT=8080
POSTGRES_PASSWORD=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
DATABASE_URL=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT

# NODE_ENV is explicitly not "production" — kept conservative to match the
# qm-kubernetes precedent's closed/single-operator framing. The public
# origin below is genuinely https (Caddy terminates TLS on the droplet's
# bare IP with a Let's Encrypt short-lived cert — see README.md), which is
# what QM's own sign-in flow actually requires; NODE_ENV itself doesn't
# need to change for that.
NODE_ENV=development

# --- Signing secrets (generated on first boot, do not share) --------------
CORE_SIGNING_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
CAPABILITY_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
PORTAL_IDENTITY_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
CONNECTOR_SECRET_KEY=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
SKILL_SIGNING_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
PORTAL_SESSION_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
AUTH_TOKEN_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
AUTH_CLIENT_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
# P-256 private JWK the embedded auth broker signs id_tokens with.
AUTH_SIGNING_JWK=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
# Non-secret: the embedded broker's own OIDC client id (portal presents this
# to itself, nothing external).
AUTH_CLIENT_ID=qm-portal
# portal reads its own OIDC client identity from OIDC_CLIENT_ID/SECRET, not
# AUTH_CLIENT_ID/SECRET (plugins/portal/src/index.ts has no fallback between
# them) — these must equal AUTH_CLIENT_ID/AUTH_CLIENT_SECRET exactly, or the
# embedded broker rejects the request as "an unknown application".
OIDC_CLIENT_ID=qm-portal
OIDC_CLIENT_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT

# --- Public origin (droplet IP, no domain, HTTPS via Caddy) — rewritten on
# first boot. QM's own sign-in flow (the password form's same-origin check,
# and the CLI's admin-login link) refuses to work at all over plain HTTP on
# a public IP — see README.md "Why Caddy" — so this must stay https://.
PUBLIC_URL=https://PLACEHOLDER_DOMAIN
PORTAL_PUBLIC_URL=https://PLACEHOLDER_DOMAIN
WEB_UI_PUBLIC_URL=https://PLACEHOLDER_DOMAIN
AGENT_API_URL=https://PLACEHOLDER_DOMAIN
PUBLIC_WEB_URL=https://PLACEHOLDER_DOMAIN
OIDC_ISSUER=https://PLACEHOLDER_DOMAIN/idp
OIDC_AUTH_ENDPOINT=https://PLACEHOLDER_DOMAIN/idp/authorize
AUTH_ISSUER=https://PLACEHOLDER_DOMAIN/idp
AUTH_REDIRECT_URI=https://PLACEHOLDER_DOMAIN/auth/callback

# --- Internal service wiring (static — matches deploy/helm/templates) -----
# auth runs embedded inside portal (loopback), admin embedded inside web-ui.
CORE_API_URL=http://core:8080
WEB_UI_UPSTREAM=http://web-ui:8080
ADMIN_UPSTREAM=http://web-ui:8080/admin
ADMIN_BASE_PATH=/admin
ADMIN_ENABLED=1
AUTH_BROKER_UPSTREAM=http://127.0.0.1:8099
AUTH_EMBEDDED=1
AUTH_BROKER_PREFIX=/idp
OIDC_TOKEN_ENDPOINT=http://127.0.0.1:8099/token
OIDC_USERINFO_ENDPOINT=http://127.0.0.1:8099/userinfo
OIDC_JWKS_URI=http://127.0.0.1:8099/.well-known/jwks.json
OIDC_SCOPES=openid email
OIDC_PRINCIPAL_CLAIM=email
