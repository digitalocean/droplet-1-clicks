#!/bin/bash
set -euo pipefail

set -a
# shellcheck source=/dev/null
source /etc/environment 2>/dev/null || true
set +a

# shellcheck source=/srv/qm/env-lib.sh
source /srv/qm/env-lib.sh

INFO_FILE=/root/qm_info.txt
DROPLET_IP="$(droplet_ip)"

# --- Generate per-droplet signing secrets --------------------------------
if env_is_placeholder CORE_SIGNING_SECRET; then
  echo "Generating QM signing secrets..."
  for key in CORE_SIGNING_SECRET CAPABILITY_SECRET PORTAL_IDENTITY_SECRET \
             CONNECTOR_SECRET_KEY SKILL_SIGNING_SECRET PORTAL_SESSION_SECRET \
             AUTH_TOKEN_SECRET; do
    write_env_kv "$key" "$(openssl rand -hex 32)"
  done
  # portal authenticates to the embedded auth broker as an OIDC client using
  # OIDC_CLIENT_ID/OIDC_CLIENT_SECRET (plugins/portal/src/index.ts), while the
  # broker itself is configured with AUTH_CLIENT_ID/AUTH_CLIENT_SECRET
  # (plugins/auth/src/config.ts) — these must be the exact same values on
  # both sides, there is no fallback between the two names.
  CLIENT_SECRET="$(openssl rand -hex 32)"
  write_env_kv AUTH_CLIENT_SECRET "$CLIENT_SECRET"
  write_env_kv OIDC_CLIENT_SECRET "$CLIENT_SECRET"
  write_env_kv AUTH_SIGNING_JWK "$(python3 /srv/qm/gen-secrets.py jwk)"
fi

# --- Generate the Postgres password + DATABASE_URL ------------------------
# Always generate POSTGRES_PASSWORD regardless of which path below is taken
# — compose.yml's local `postgres` service requires it even when gated
# behind the "local-postgres" profile and never actually started, so there
# is no ambiguity around whether Compose would error on it being unset.
if env_is_placeholder POSTGRES_PASSWORD; then
  PG_PASSWORD="$(openssl rand -hex 24)"
  write_env_kv POSTGRES_PASSWORD "$PG_PASSWORD"

  # DigitalOcean's own Managed Database automation may have dropped DBaaS
  # Postgres credentials on this droplet before first boot (see
  # env-lib.sh's detect_do_dbaas_credentials) — when present, QM uses that
  # database instead of the bundled local one, which is then turned off
  # entirely (see compose.yml's "local-postgres" profile).
  if detect_do_dbaas_credentials && bootstrap_do_dbaas; then
    write_env_kv DATABASE_URL "$DO_DBAAS_URL"
    write_env_kv COMPOSE_PROFILES ""
    echo "Using the attached DigitalOcean Managed Database — local Postgres is disabled."
  else
    write_env_kv DATABASE_URL "postgresql://qm:${PG_PASSWORD}@postgres:5432/qm?sslmode=disable"
    write_env_kv COMPOSE_PROFILES "local-postgres"
  fi
fi

# --- Point the public origin at this droplet's IP (no domain) ------------
if grep -q "PLACEHOLDER_DOMAIN" "$ENV_FILE" 2>/dev/null; then
  sed -i "s|PLACEHOLDER_DOMAIN|${DROPLET_IP}|g" "$ENV_FILE"
fi

# --- Install Caddy (HTTPS on the bare IP, Let's Encrypt short-lived cert) -
# QM's sign-in flow (password form + the CLI's admin-login link) refuses to
# work at all over plain HTTP on a public IP — see README.md "Why Caddy".
if [ -f /etc/caddy/Caddyfile.tmp ]; then
  mv /etc/caddy/Caddyfile.tmp /etc/caddy/Caddyfile
fi
if grep -q "PLACEHOLDER_DOMAIN" /etc/caddy/Caddyfile 2>/dev/null; then
  sed -i "s/PLACEHOLDER_DOMAIN/${DROPLET_IP}/" /etc/caddy/Caddyfile
fi
systemctl enable caddy
systemctl restart caddy

# Remove the ssh force logout command installed at build time
sed -e '/Match User root/d' \
    -e '/.*ForceCommand.*droplet.*/d' \
    -i /etc/ssh/sshd_config

chmod +x /srv/qm/gen-secrets.py /etc/setup_wizard.sh

# Pick a model choice from droplet env vars: an explicit MODEL_PROVIDER wins
# ("anthropic", "openai", or "do-inference" — the last is this script's own
# sentinel, written to .env as a blank MODEL_PROVIDER, never literally; see
# env.template), otherwise infer from whichever single key was supplied,
# default anthropic. DigitalOcean's own GenAI automation may have dropped
# Serverless Inference credentials on this droplet before first boot (see
# env-lib.sh's detect_do_genai_credentials) — when present, it always wins
# over any of the above, since there is nothing left for the operator to
# choose.
if detect_do_genai_credentials; then
  MODEL_CHOICE_ENV=do-inference
  DO_INFERENCE_MODEL_ID="$DO_GENAI_MODEL"
  DO_INFERENCE_MODEL_NAME="$DO_GENAI_MODEL"
  DO_INFERENCE_CONTEXT_WINDOW="$DO_GENERIC_CONTEXT_WINDOW"
  DO_INFERENCE_MAX_TOKENS="$DO_GENERIC_MAX_TOKENS"
  DO_SERVERLESS_INFERENCE_API_KEY="$DO_GENAI_KEY"
  ANTHROPIC_API_KEY=""
  OPENAI_API_KEY=""
else
  MODEL_CHOICE_ENV="${MODEL_PROVIDER:-}"
  if [ -z "$MODEL_CHOICE_ENV" ]; then
    if [ -n "${DO_SERVERLESS_INFERENCE_API_KEY:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -z "${OPENAI_API_KEY:-}" ]; then
      MODEL_CHOICE_ENV=do-inference
    elif [ -n "${OPENAI_API_KEY:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
      MODEL_CHOICE_ENV=openai
    else
      MODEL_CHOICE_ENV=anthropic
    fi
  fi
fi

HAS_MODEL_KEY=0
MODEL_PROVIDER_ENV=""
PI_MODEL_ENV=""
OPENAI_API_KEY_ENV="${OPENAI_API_KEY:-}"
case "$MODEL_CHOICE_ENV" in
  do-inference)
    PI_MODEL_ENV="$DO_INFERENCE_MODEL_ID"
    if [ -n "${DO_SERVERLESS_INFERENCE_API_KEY:-}" ]; then
      HAS_MODEL_KEY=1
      # Confirmed live on a real deployment: portal's hard redirect-to-
      # onboarding gate (modelProviderConfigured, src/api/routes/surface.ts)
      # only checks the 3 built-in provider credential slots — it has no
      # awareness of custom model providers, even though the custom-provider
      # model itself resolves and answers chat turns correctly. Without
      # this, every admin login redirects to onboarding with no way to
      # dismiss it. Bystander credential only — doesn't change which model
      # actually answers (PI_MODEL/the custom provider registration govern
      # that). Side effect: built-in OpenAI-branded models become
      # selectable in the picker and would fail if manually chosen.
      OPENAI_API_KEY_ENV="$DO_SERVERLESS_INFERENCE_API_KEY"
    fi
    ;;
  openai)
    MODEL_PROVIDER_ENV=openai
    if [ -n "${OPENAI_API_KEY:-}" ]; then HAS_MODEL_KEY=1; fi
    ;;
  *)
    MODEL_PROVIDER_ENV=anthropic
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then HAS_MODEL_KEY=1; fi
    ;;
esac

# Pick a sandbox backend from droplet env vars the same way: an explicit
# SANDBOX_BACKEND wins (accepts "e2b" or "do-managed-agents" — see
# env-lib.sh), otherwise infer from whichever single key was supplied,
# default e2b. DigitalOcean's own internal automation may have injected a
# Managed Agents PAT (see env-lib.sh's detect_managed_agents_token) — when
# present, it always wins over any of the above, since there is nothing
# left for the operator to choose.
if detect_managed_agents_token; then
  SANDBOX_BACKEND_ENV="$MANAGED_AGENTS_SANDBOX_BACKEND_VALUE"
  DO_AGENTS_API_TOKEN="$DO_MANAGED_AGENTS_TOKEN"
  E2B_API_KEY=""
else
  SANDBOX_BACKEND_ENV="${SANDBOX_BACKEND:-}"
  if [ -z "$SANDBOX_BACKEND_ENV" ]; then
    if [ -n "${DO_AGENTS_API_TOKEN:-}" ] && [ -z "${E2B_API_KEY:-}" ]; then
      SANDBOX_BACKEND_ENV="$MANAGED_AGENTS_SANDBOX_BACKEND_VALUE"
    else
      SANDBOX_BACKEND_ENV=e2b
    fi
  fi
fi
HAS_SANDBOX_KEY=0
if [ "$SANDBOX_BACKEND_ENV" = "$MANAGED_AGENTS_SANDBOX_BACKEND_VALUE" ] && [ -n "${DO_AGENTS_API_TOKEN:-}" ]; then
  HAS_SANDBOX_KEY=1
elif [ "$SANDBOX_BACKEND_ENV" = e2b ] && [ -n "${E2B_API_KEY:-}" ]; then
  HAS_SANDBOX_KEY=1
fi

STACK_STARTED=0
if [ -n "${ADMIN_EMAIL:-}" ] && [ "$HAS_MODEL_KEY" = 1 ] && [ "$HAS_SANDBOX_KEY" = 1 ]; then
  echo "Configuring QM from droplet environment variables..."
  ADMIN_PASSWORD="${ADMIN_PASSWORD:-$(openssl rand -base64 18 | tr -d '=+/' | cut -c1-18)}"
  PW_HASH="$(printf '%s\n' "$ADMIN_PASSWORD" | python3 /srv/qm/gen-secrets.py hash-password)"
  write_env_kv MODEL_PROVIDER "$MODEL_PROVIDER_ENV"
  write_env_kv ANTHROPIC_API_KEY "${ANTHROPIC_API_KEY:-}"
  write_env_kv OPENAI_API_KEY "$OPENAI_API_KEY_ENV"
  write_env_kv DO_SERVERLESS_INFERENCE_API_KEY "${DO_SERVERLESS_INFERENCE_API_KEY:-}"
  write_env_kv PI_MODEL "$PI_MODEL_ENV"
  write_env_kv SANDBOX_BACKEND "$SANDBOX_BACKEND_ENV"
  write_env_kv E2B_API_KEY "${E2B_API_KEY:-}"
  write_env_kv DO_AGENTS_API_TOKEN "${DO_AGENTS_API_TOKEN:-}"
  write_env_kv ADMIN_GRANTS "${ADMIN_EMAIL}:org_admin"
  write_env_kv AUTH_ALLOWED_EMAILS "$ADMIN_EMAIL"
  write_env_kv OIDC_ALLOWED_EMAILS "$ADMIN_EMAIL"
  write_env_kv AUTH_PASSWORD_USERS "${ADMIN_EMAIL}:${PW_HASH}"

  (cd /srv/qm && docker compose up -d)
  echo "Containers are up — giving Postgres + core a moment to finish starting (30s)..."
  sleep 30

  MODEL_SUMMARY="$MODEL_PROVIDER_ENV"
  if [ "$MODEL_CHOICE_ENV" = do-inference ]; then
    register_do_inference_provider "$DO_SERVERLESS_INFERENCE_API_KEY" || true
    MODEL_SUMMARY="DigitalOcean Serverless Inference (${DO_INFERENCE_MODEL_ID})"
  fi
  SANDBOX_SUMMARY_ENV="e2b"
  if [ "$SANDBOX_BACKEND_ENV" = "$MANAGED_AGENTS_SANDBOX_BACKEND_VALUE" ]; then
    SANDBOX_SUMMARY_ENV="DigitalOcean Managed Agents"
  fi
  STACK_STARTED=1
elif ! grep -q 'setup_wizard.sh' /root/.bashrc 2>/dev/null; then
  cat >> /root/.bashrc <<'EOM'

chmod +x /etc/setup_wizard.sh
/etc/setup_wizard.sh
EOM
fi

cat > "$INFO_FILE" << EOF
================================================================================
QM 1-Click Droplet - Getting Started
================================================================================

QM (https://github.com/yc-software/qm) is a self-hosted multiplayer agent
harness. This droplet runs core, web-ui, and portal (auth and admin run
embedded, not as separate containers) plus a bundled Postgres.

ACCESS:
  Web UI:   https://${DROPLET_IP}
  (Caddy uses a Let's Encrypt short-lived certificate for the bare IP —
  your browser may not trust it yet and show a warning; see README.md.)
EOF

if [ "$STACK_STARTED" = "1" ]; then
  cat >> "$INFO_FILE" << EOF
  Admin:    ${ADMIN_EMAIL}
  Password: ${ADMIN_PASSWORD}
  Model:    ${MODEL_SUMMARY}
  Sandbox:  ${SANDBOX_SUMMARY_ENV}

  Your QM is ready. Sign in with the credentials above (also in
  /srv/qm/.env as AUTH_PASSWORD_USERS). This is the only sign-in method
  configured — see README.md to add real email or SSO sign-in later.
EOF
else
  cat >> "$INFO_FILE" << 'EOF'
  QM is not started yet — the admin email and API keys were not set as
  droplet environment variables. Finish setup over SSH:

    ssh root@<droplet-ip>

  The setup wizard runs automatically on first login, or manually with:
    sudo /etc/setup_wizard.sh
EOF
fi

cat >> "$INFO_FILE" << 'EOF'

MANAGEMENT:
  Start:    /srv/qm/start-qm.sh     (or systemctl-free: docker compose -f /srv/qm/compose.yml up -d)
  Stop:     /srv/qm/stop-qm.sh
  Restart:  /srv/qm/restart-qm.sh
  Status:   /srv/qm/status-qm.sh
  Update:   /srv/qm/update-qm.sh
  Logs:     docker compose -f /srv/qm/compose.yml logs -f
  Setup:    sudo /etc/setup_wizard.sh

PATHS:
  Stack:    /srv/qm
  Env:      /srv/qm/.env  (symlink: /srv/qm.env)
  Info:     /root/qm_info.txt

SECURITY:
  Portal is served over HTTPS via Caddy on this droplet's public IP (no
  domain — Let's Encrypt's short-lived IP-certificate program). Browsers
  don't universally trust this cert type yet, so you'll likely see a
  warning on first visit; verify the fingerprint if that matters to you.
  core/web-ui/Postgres stay bound to loopback, not publicly reachable.
  Prefer a DigitalOcean Cloud Firewall restricting SSH (and optionally
  HTTP/HTTPS) to your IP.

DOCS:
  https://github.com/yc-software/qm

================================================================================
EOF
chmod 600 "$INFO_FILE"

systemctl restart ssh

echo "QM first-boot initialization complete!"
echo "Access info saved to ${INFO_FILE}"
