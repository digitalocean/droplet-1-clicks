#!/bin/bash
#
# private: close public ports on this Droplet.
# SSH moves to Tailscale; web traffic goes out through Cloudflare Tunnel.

set -euo pipefail

STATE_DIR=/var/lib/private-by-default
LOG=/var/log/private-by-default.log
TUNNEL_ENV=/etc/cloudflared/tunnel.env
WIZARD=/etc/setup_wizard.sh
FRONT_DOOR=8080

usage() {
  cat <<'EOF'
Usage: private <command> [options]

Commands:
  setup                  Guided setup (recommended for people)
  connect                Join your tailnet with Tailscale SSH enabled
      --auth-key-file F    Read a Tailscale auth key from file F
                           (or set TAILSCALE_AUTHKEY in the environment).
                           Without a key, prints a sign-in link and waits.
      --timeout D          How long to wait, e.g. 90s or 15m (default 15m)
  close-ssh [--yes]      Close public SSH (port 22). Tailscale must be connected.
  open-ssh               Re-open public SSH on port 22 (keys only, rate limited)
  tunnel                 Run a permanent Cloudflare Tunnel as a service
      --token-file F       Read the tunnel token from file F
                           (or set CLOUDFLARE_TUNNEL_TOKEN in the environment).
                           In a terminal, prompts for the token if neither is set.
      --remove             Stop and remove the tunnel
  welcome on|off         Test page on localhost:8080. Turn it off and run your
                         own app on port 8080; Cloudflare keeps pointing there.
  status [--json]        Show what this Droplet exposes

Locked out? Control panel > Droplet > Settings > Reset root password, then
Settings > Recovery console > Launch Console. Log in as root and run:
private open-ssh
EOF
}

die() { echo "private: $*" >&2; exit 1; }
log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG" 2>/dev/null || true; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root: sudo private $*"; }

ts_json()  { tailscale status --json 2>/dev/null || true; }
ts_state() { local s; s=$(ts_json | jq -r '.BackendState // empty' 2>/dev/null || true); echo "${s:-Stopped}"; }
ts_ip()    { tailscale ip -4 2>/dev/null | head -n1 || true; }
ts_name()  { ts_json | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/\.$//' || true; }

ufw_active()      { ufw status 2>/dev/null | head -n1 | grep -q 'Status: active'; }
public_ssh_open() {
  ! ufw_active || ufw status 2>/dev/null \
    | grep -E '^(22(/tcp)?|OpenSSH)( \(v6\))?( on [^ ]+)?[[:space:]]+(ALLOW|LIMIT)' >/dev/null
}
password_login() {
  [ "$(sshd -T 2>/dev/null | awk 'tolower($1)=="passwordauthentication"{print tolower($2)}')" = yes ]
}
tunnel_active()   { systemctl is-active --quiet cloudflared-tunnel; }
welcome_active()  { systemctl is-active --quiet private-welcome; }
listening()       { ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }

KEY_TMP=""
cleanup_key() { [ -z "$KEY_TMP" ] || rm -f "$KEY_TMP"; }

cmd_connect() {
  need_root connect
  local key_file="" timeout="15m"
  while [ $# -gt 0 ]; do
    case "$1" in
      --auth-key-file) key_file="${2:-}"; shift 2 ;;
      --timeout)       timeout="${2:-}"; shift 2 ;;
      *) die "unknown option for connect: $1" ;;
    esac
  done

  if [ -z "$key_file" ] && [ -n "${TAILSCALE_AUTHKEY:-}" ]; then
    KEY_TMP=$(mktemp)
    trap cleanup_key EXIT
    printf '%s' "$TAILSCALE_AUTHKEY" >"$KEY_TMP"
    key_file=$KEY_TMP
  fi
  [ -z "$key_file" ] || [ -r "$key_file" ] || die "cannot read $key_file"

  systemctl enable --now tailscaled >/dev/null 2>&1 || die "could not start tailscaled"
  ufw allow in on tailscale0 >/dev/null

  if [ "$(ts_state)" = "Running" ]; then
    tailscale set --ssh
  else
    local args=(up --ssh --hostname="$(hostname -s)" --timeout="$timeout")
    if [ -n "$key_file" ]; then
      args+=(--auth-key="file:$key_file")
    else
      echo "Open the link below in your browser and approve this Droplet."
    fi
    tailscale "${args[@]}" || die "Tailscale did not connect. Public SSH is unchanged."
  fi

  local i
  for i in $(seq 1 30); do
    [ "$(ts_state)" = "Running" ] && [ -n "$(ts_ip)" ] && break
    sleep 1
  done
  [ "$(ts_state)" = "Running" ] && [ -n "$(ts_ip)" ] || die "Tailscale is not running. Public SSH is unchanged."

  log "tailscale connected ip=$(ts_ip) name=$(ts_name)"
  echo "Connected to Tailscale as $(ts_name) ($(ts_ip))"
}

cmd_close_ssh() {
  need_root close-ssh
  local yes=0
  [ "${1:-}" = "--yes" ] && yes=1

  [ "$(ts_state)" = "Running" ] && [ -n "$(ts_ip)" ] \
    || die "Tailscale is not connected, so closing port 22 would lock you out. Run: private connect"

  if [ "$yes" -eq 0 ]; then
    [ -t 0 ] || die "refusing to close port 22 without --yes in a non-interactive shell"
    echo "Check that this works from another terminal first: ssh root@$(ts_name)"
    local ans
    read -r -p "Type yes to close public SSH: " ans
    [ "$ans" = "yes" ] || { echo "Public SSH left open."; exit 1; }
  fi

  ufw allow in on tailscale0 >/dev/null
  ufw default deny incoming >/dev/null
  local rule
  for rule in "limit 22/tcp" "allow 22/tcp" "limit 22" "allow 22" "limit OpenSSH" "allow OpenSSH"; do
    # shellcheck disable=SC2086
    ufw --force delete $rule >/dev/null 2>&1 || true
  done
  ufw --force enable >/dev/null

  public_ssh_open && die "port 22 is still open; check: ufw status"
  install -d -m 0700 "$STATE_DIR"
  touch "$STATE_DIR/wizard-done"
  log "public ssh closed"
  echo "Port 22 is closed to the internet. SSH now works only over Tailscale."
}

cmd_open_ssh() {
  need_root open-ssh
  ufw limit 22/tcp >/dev/null
  ufw --force enable >/dev/null
  log "public ssh opened"
  echo "Port 22 is open to the internet again (SSH keys only, rate limited)."
  echo "Close it again with: private close-ssh"
}

cmd_tunnel() {
  need_root tunnel
  local token_file="" remove=0 token=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --token-file) token_file="${2:-}"; shift 2 ;;
      --remove)     remove=1; shift ;;
      *) die "unknown option for tunnel: $1" ;;
    esac
  done

  if [ "$remove" -eq 1 ]; then
    systemctl disable --now cloudflared-tunnel >/dev/null 2>&1 || true
    rm -f "$TUNNEL_ENV"
    log "tunnel removed"
    echo "Cloudflare Tunnel removed."
    return
  fi

  if [ -n "$token_file" ]; then
    token=$(tr -d '[:space:]' <"$token_file")
  elif [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
    token=$CLOUDFLARE_TUNNEL_TOKEN
  elif [ -t 0 ]; then
    read -r -s -p "Paste your Cloudflare Tunnel token (input hidden): " token
    echo
  fi
  [ -n "$token" ] || die "no tunnel token given"
  [[ "$token" =~ ^[A-Za-z0-9+/=_-]+$ ]] || die "that does not look like a Cloudflare Tunnel token"

  install -d -m 0700 /etc/cloudflared
  (umask 077 && printf 'TUNNEL_TOKEN=%s\n' "$token" >"$TUNNEL_ENV")
  systemctl enable cloudflared-tunnel >/dev/null 2>&1
  systemctl restart cloudflared-tunnel

  local i
  for i in $(seq 1 20); do
    journalctl -u cloudflared-tunnel --since "-30s" -o cat 2>/dev/null | grep -q 'Registered tunnel connection' && break
    sleep 1
  done
  tunnel_active || die "the tunnel service failed to start; see: journalctl -u cloudflared-tunnel"

  log "tunnel installed"
  echo "Cloudflare Tunnel is running."
  echo "In the Cloudflare dashboard (Zero Trust > Networks > Tunnels > your tunnel),"
  echo "add a public hostname with service http://localhost:$FRONT_DOOR"
  listening "$FRONT_DOOR" || echo "Nothing is on port $FRONT_DOOR yet. For a test page run: private welcome on"
}

cmd_welcome() {
  need_root welcome
  case "${1:-}" in
    on)
      if ! welcome_active && listening "$FRONT_DOOR"; then
        die "something else is already using port $FRONT_DOOR"
      fi
      systemctl enable --now private-welcome >/dev/null 2>&1 || die "the welcome page did not start; see: journalctl -u private-welcome"
      log "welcome page on"
      echo "Welcome page is running on localhost:$FRONT_DOOR (not public by itself)."
      echo "Public test URL: expose $FRONT_DOOR"
      ;;
    off)
      systemctl disable --now private-welcome >/dev/null 2>&1 || true
      log "welcome page off"
      echo "Welcome page stopped. Port $FRONT_DOOR is free for your app."
      echo "Start your app on localhost:$FRONT_DOOR; existing Cloudflare URLs will serve it."
      ;;
    *) die "usage: private welcome on|off" ;;
  esac
}

cmd_status() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1

  local ssh_open=false fw=false pw=false tun=false wel=false door=false
  local state ip name previews="[]" err=""
  public_ssh_open && ssh_open=true
  ufw_active && fw=true
  password_login && pw=true
  tunnel_active && tun=true
  welcome_active && wel=true
  listening "$FRONT_DOOR" && door=true
  state=$(ts_state)
  ip=$(ts_ip)
  name=$(ts_name)
  if [ "$(id -u)" -eq 0 ]; then
    previews=$(/usr/local/bin/expose --list --json 2>/dev/null || echo "[]")
    [ -s "$STATE_DIR/last-error" ] && err=$(cat "$STATE_DIR/last-error")
  fi

  if [ "$json" -eq 1 ]; then
    jq -n \
      --argjson ssh_open "$ssh_open" --argjson fw "$fw" --argjson pw "$pw" \
      --argjson tun "$tun" --arg state "$state" --arg ip "$ip" --arg name "$name" \
      --argjson previews "$previews" --argjson wel "$wel" --argjson door "$door" \
      --argjson port "$FRONT_DOOR" --arg err "$err" \
      '{public_ssh_open: $ssh_open, firewall_active: $fw, password_login: $pw,
        tailscale: {state: $state, ip: $ip, dns_name: $name},
        front_door: {port: $port, listening: $door, welcome_page: $wel},
        tunnel: {active: $tun}, previews: $previews,
        last_error: (if $err == "" then null else $err end)}'
    return
  fi

  local WARN=$'\e[1;31m' N=$'\e[0m'
  local row='  %-16s %s\n' short=${name%%.*}

  if [ "$ssh_open" = true ]; then
    echo "${WARN}⚠️  WARNING: Anyone on the internet can try to log in over SSH (port 22).${N}"
    echo "    Fix it in about 2 minutes: private setup"
    echo "    (moves SSH to Tailscale, then closes port 22)"
  elif [ "$state" = "Running" ]; then
    echo "✓ SSH works only over Tailscale: ssh root@${short:-$ip}"
  else
    echo "${WARN}⚠️  WARNING: Port 22 is closed and Tailscale is not connected.${N}"
    echo "    Reconnect with: private connect"
    echo "    Or re-open public SSH with: private open-ssh"
  fi
  echo
  echo "Status:"

  if [ "$fw" != true ]; then
    printf "$row" "Firewall:" "${WARN}OFF${N} (turn it on: ufw --force enable)"
  elif [ "$ssh_open" = true ]; then
    printf "$row" "Firewall:" "UFW enabled, all inbound ports BLOCKED except 22 (SSH)"
  else
    printf "$row" "Firewall:" "UFW enabled, all inbound ports BLOCKED, including 22 (SSH)"
  fi

  if [ "$ssh_open" != true ]; then
    printf "$row" "Public SSH:" "closed"
  elif [ "$pw" = true ]; then
    printf "$row" "Public SSH:" "OPEN on port 22, password login on (no SSH key at create time)"
  else
    printf "$row" "Public SSH:" "OPEN on port 22 (keys only, rate limited)"
  fi

  if [ "$state" = "Running" ]; then
    printf "$row" "Tailscale SSH:" "ssh root@${short:-$ip} ($ip)"
  else
    printf "$row" "Tailscale SSH:" "not connected"
  fi

  local web=() door_label=""
  [ "$wel" = true ] && door_label=" (welcome page)"
  while IFS=$'\t' read -r port url; do
    [ -n "$port" ] || continue
    if [ "$port" = "$FRONT_DOOR" ]; then
      web+=("$url -> localhost:$port$door_label")
    else
      web+=("$url -> localhost:$port")
    fi
  done < <(jq -r '.[] | "\(.port)\t\(.url)"' <<<"$previews" 2>/dev/null)
  [ "$tun" = true ] && web+=("Cloudflare Tunnel running (hostnames are set in the Cloudflare dashboard)")
  if [ "${#web[@]}" -eq 0 ]; then
    if [ "$wel" = true ]; then
      printf "$row" "Web:" "nothing public; welcome page on localhost:$FRONT_DOOR"
    else
      printf "$row" "Web:" "nothing public"
    fi
  else
    local first=1 w
    for w in "${web[@]}"; do
      if [ "$first" -eq 1 ]; then printf "$row" "Web:" "$w"; first=0; else printf "$row" "" "$w"; fi
    done
  fi

  [ -z "$err" ] || printf "$row" "Last error:" "${WARN}${err}${N}"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  setup)     need_root setup; exec "$WIZARD" --force ;;
  connect)   cmd_connect "$@" ;;
  close-ssh) cmd_close_ssh "$@" ;;
  open-ssh)  cmd_open_ssh ;;
  tunnel)    cmd_tunnel "$@" ;;
  welcome)   cmd_welcome "$@" ;;
  status)    cmd_status "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
