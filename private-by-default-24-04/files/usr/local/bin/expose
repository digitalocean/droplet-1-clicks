#!/bin/bash
#
# expose: public HTTPS preview URL for a local port, through a Cloudflare
# quick tunnel. No inbound ports are opened and no account is needed.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  expose <port> [--json]     Public preview URL for http://localhost:<port>
  expose --list [--json]     Show running previews
  expose --stop <port>       Stop a preview

Anyone with a preview URL can reach that port. Quick tunnels are for testing:
the URL changes when the preview restarts and previews stop on reboot.
For a permanent address on your own domain, use: private tunnel
EOF
}

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -n /usr/local/bin/expose "$@"
fi

die() { echo "expose: $*" >&2; exit 1; }

valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

preview_url() {
  local id
  id=$(systemctl show -p InvocationID --value "expose@$1" 2>/dev/null || true)
  [ -n "$id" ] || return 0
  journalctl "_SYSTEMD_INVOCATION_ID=$id" -o cat --no-pager 2>/dev/null \
    | grep -o 'https://[-a-z0-9]*\.trycloudflare\.com' | tail -n1 || true
}

running_ports() {
  systemctl list-units 'expose@*.service' --state=active --no-legend --plain 2>/dev/null \
    | awk '{print $1}' | sed -E 's/^expose@([0-9]+)\.service$/\1/' | grep -E '^[0-9]+$' || true
}

list() {
  local json=$1 port out="[]"
  for port in $(running_ports); do
    out=$(jq --argjson p "$port" --arg u "$(preview_url "$port")" '. + [{port: $p, url: $u}]' <<<"$out")
  done
  if [ "$json" -eq 1 ]; then
    echo "$out"
  elif [ "$(jq length <<<"$out")" -eq 0 ]; then
    echo "No previews running. Start one with: expose <port>"
  else
    jq -r '.[] | "localhost:\(.port)  ->  \(.url)"' <<<"$out"
  fi
}

start() {
  local port=$1 json=$2 url="" i
  valid_port "$port" || die "not a valid port: $port"

  if ! systemctl is-active --quiet "expose@$port"; then
    if ! ss -ltnH "sport = :$port" 2>/dev/null | grep -q .; then
      [ "$json" -eq 1 ] || echo "Note: nothing is listening on port $port yet. The URL will work once your app starts."
    fi
    systemctl start "expose@$port"
  fi

  for i in $(seq 1 30); do
    url=$(preview_url "$port")
    [ -n "$url" ] && break
    sleep 1
  done
  [ -n "$url" ] || die "no URL after 30s; see: journalctl -u expose@$port"

  if [ "$json" -eq 1 ]; then
    jq -n --argjson p "$port" --arg u "$url" '{port: $p, url: $u}'
    return
  fi
  cat <<EOF
Public preview URL for localhost:$port:

    $url

Anyone with this link can reach that port. It can take a few seconds to start working.
Stop it with: expose --stop $port
EOF
}

json=0
args=()
for a in "$@"; do
  if [ "$a" = "--json" ]; then json=1; else args+=("$a"); fi
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
  --list) list "$json" ;;
  --stop)
    valid_port "${2:-}" || die "usage: expose --stop <port>"
    systemctl stop "expose@$2"
    echo "Stopped preview for localhost:$2"
    ;;
  -h|--help|"") usage ;;
  *) start "$1" "$json" ;;
esac
