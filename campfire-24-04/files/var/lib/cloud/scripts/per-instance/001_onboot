#!/bin/bash
set -euo pipefail

# Generate unique SECRET_KEY_BASE for this droplet
if grep -q "PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT" /opt/campfire.env 2>/dev/null; then
    echo "Generating unique SECRET_KEY_BASE for this droplet..."
    NEW_SECRET_KEY_BASE=$(openssl rand -hex 64)
    sed -i "s/SECRET_KEY_BASE=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT/SECRET_KEY_BASE=$NEW_SECRET_KEY_BASE/" /opt/campfire.env
    echo "SECRET_KEY_BASE generated successfully."
fi

# Configure Caddy with this droplet's public IP for shortlived HTTPS
meta() { curl -fsS --retry 10 --retry-connrefused --max-time 2 "$1"; }
DROPLET_PUBLIC_IP="$(meta http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address 2>/dev/null || true)"
DROPLET_PRIVATE_IP="$(hostname -I | awk '{print $1}')"
DROPLET_IP="${DROPLET_PUBLIC_IP:-$DROPLET_PRIVATE_IP}"

if [ -z "${DROPLET_IP}" ]; then
    echo "ERROR: Unable to determine droplet IP; cannot configure Caddy." >&2
    exit 1
fi

if [ ! -f /etc/caddy/Caddyfile.tmp ]; then
    echo "ERROR: Missing /etc/caddy/Caddyfile.tmp; cannot configure Caddy." >&2
    exit 1
fi

sed "s/PLACEHOLDER_DOMAIN/${DROPLET_IP}/" /etc/caddy/Caddyfile.tmp > /etc/caddy/Caddyfile

# Pick up caddy.service.d override (After/Wants docker) before first start.
systemctl daemon-reload
systemctl enable caddy

# Remove the ssh force logout command
sed -e '/Match User root/d' \
    -e '/.*ForceCommand.*droplet.*/d' \
    -i /etc/ssh/sshd_config

systemctl restart ssh

campfire_running() {
    [ "$(docker inspect -f '{{.State.Running}}' campfire 2>/dev/null)" = "true" ]
}

start_campfire_fallback() {
    echo "Attempting fallback Campfire start..."
    docker stop campfire 2>/dev/null || true
    docker rm campfire 2>/dev/null || true
    docker run \
        --detach \
        --name campfire \
        --publish 127.0.0.1:8080:80 \
        --restart unless-stopped \
        --volume campfire:/rails/storage \
        --env-file /opt/campfire.env \
        campfire
}

wait_for_campfire() {
    j=0
    while [ "$j" -lt 30 ]; do
        if campfire_running; then
            return 0
        fi
        j=$((j + 1))
        sleep 2
    done
    return 1
}

# Apply the new env and ensure the container is running.
# Do NOT run /opt/update-campfire.sh on first boot: it stop/rm + rebuilds from
# GitHub and races Marketplace autoupdate QA (container missing → test4 fail).
# Users can still update later via /opt/update-campfire.sh (see MOTD).
if [ -x "/opt/restart-campfire.sh" ]; then
    # Docker may still be starting after boot.
    i=0
    while [ "$i" -lt 30 ]; do
        if docker info >/dev/null 2>&1; then
            break
        fi
        i=$((i + 1))
        sleep 2
    done

    if ! docker info >/dev/null 2>&1; then
        echo "ERROR: Docker did not become ready within 60s; skipping Campfire restart." >&2
        exit 1
    fi

    echo "Restarting Campfire with droplet-specific environment..."
    if ! /opt/restart-campfire.sh; then
        echo "WARNING: /opt/restart-campfire.sh failed; trying fallback start." >&2
        if ! start_campfire_fallback; then
            echo "ERROR: Fallback Campfire start failed." >&2
            exit 1
        fi
    fi

    echo "Waiting for Campfire container to be running..."
    if ! wait_for_campfire; then
        echo "WARNING: Campfire not running after restart; trying fallback start." >&2
        if ! start_campfire_fallback; then
            echo "ERROR: Could not start Campfire container." >&2
            exit 1
        fi
        if ! wait_for_campfire; then
            echo "ERROR: Campfire container still not running after fallback." >&2
            exit 1
        fi
    fi
    echo "Campfire container is running."
else
    echo "Restart script not found. Skipping Campfire restart."
fi

echo "Waiting for Campfire to accept connections on 127.0.0.1:8080..."
campfire_ready=false
k=0
while [ "$k" -lt 30 ]; do
    if curl -fsS --max-time 2 "http://127.0.0.1:8080/" >/dev/null 2>&1; then
        campfire_ready=true
        break
    fi
    k=$((k + 1))
    sleep 2
done

if [ "${campfire_ready}" != true ]; then
    echo "WARNING: Campfire did not respond on 127.0.0.1:8080 within 60s; starting Caddy anyway (clients may see 502 until the app is up)." >&2
fi

echo "Starting Caddy (HTTPS reverse proxy to Campfire on 127.0.0.1:8080)..."
systemctl daemon-reload
systemctl restart caddy
