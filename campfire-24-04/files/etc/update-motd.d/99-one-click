#!/bin/sh
#
# Configured as part of the DigitalOcean 1-Click Image build process

pub=$(curl -fsS --retry 3 --retry-connrefused --max-time 3 \
  http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address 2>/dev/null || true)
myip="${pub:-$(hostname -I | awk '{print$1}')}"

cat <<EOF
********************************************************************************

Campfire, a simple group chat application designed for small teams and organizations.
Campfire provides real-time messaging with a clean, distraction-free interface
perfect for focused team communication.

Access Campfire over HTTPS (Caddy + short-lived IP certificate):

  https://$myip

To attach a custom domain later:

  /opt/setup-campfire-domain.sh

To modify the configuration, access the following file:

  /opt/campfire.env

After making changes, restart Campfire with:

  /opt/restart-campfire.sh

To update Campfire to the latest version:

  /opt/update-campfire.sh

Note: Use the restart script instead of 'docker restart' to ensure
environment variable changes take effect. Campfire listens on
127.0.0.1:8080 only; public traffic is via Caddy on ports 80/443.

********************************************************************************
To delete this message of the day: rm -rf $(readlink -f ${0})
EOF
