#!/bin/sh
#
# Configured as part of the DigitalOcean 1-Click Image build process

# Read in the passwords....
. /root/.digitalocean_passwords

myip=$(hostname -I | awk '{print$1}')
# Installed package version (avoids stale hardcodes in this MOTD)
mongodb_version=$(mongod --version 2>/dev/null | sed -n 's/^db version v\{0,1\}//p' | head -1)
[ -n "$mongodb_version" ] || mongodb_version="unknown"

cat <<EOF
********************************************************************************

Welcome to DigitalOcean's 1-Click FARM Droplet.
To keep this Droplet secure, the UFW firewall is enabled.
All ports are BLOCKED except 22 (SSH), 80 (HTTP), 443 (HTTPS), and 8000 (API / Swagger).

FARM is configured with local MongoDB database. Use the following
credentials to manage the database:
    Username: admin
    Password: ${admin_mongodb_password}

In a web browser, you can view:
 * Your FARM website: http://$myip
 * Your API swagger: http://$myip:8000/docs
 * The FARM 1-Click Quickstart guide: link to Getting started after deploying FARM

On the server:
  * The default web root is located at /var/www/html
  * MongoDB is running on port 27017 and is bound to the local interface.
  * The passwords and keys are saved in /root/.digitalocean_passwords
  * Certbot is preinstalled. Run it to configure HTTPS. See
    https://do.co/2GOFe5J#enable-https for more detail.
  * To manage sample application pm2 deployment, login as farm user:
  $ su - farm

For help and more information, visit link to 1-click

********************************************************************************
NOTE:  This image includes version ${mongodb_version} of MongoDB.
To upgrade to a newer release run the following commands:

sudo mv /etc/apt/sources.list.d/mongodb.list.disabled /etc/apt/sources.list.d/mongodb.list
sudo apt-get update
sudo apt-get upgrade

********************************************************************************
To delete this message of the day: rm -rf $(readlink -f ${0})
EOF
