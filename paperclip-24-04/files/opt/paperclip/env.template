# Paperclip 1-Click environment (copied to /opt/paperclip.env at build time)
# Per-droplet secrets are generated on first boot.

PAPERCLIP_VERSION=PLACEHOLDER_VERSION
PAPERCLIP_HOME=/home/paperclip/.paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_NO_BROWSER=1
PAPERCLIP_OPEN_ON_LISTEN=false

# Deployment: authenticated + public behind Caddy (loopback bind)
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_BIND=loopback
PORT=3100
HOST=127.0.0.1
SERVE_UI=true
# Trust Caddy as the single reverse-proxy hop
TRUST_PROXY=1

# First-admin credentials — INITIAL_PASSWORD generated on first boot (like OmniRoute)
ADMIN_EMAIL=admin@paperclip.local
INITIAL_PASSWORD=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT

# Keep false until first admin is claimed; onboot sets true after auto-claim.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Replaced on first boot with https://<droplet-ip>
PAPERCLIP_PUBLIC_URL=https://PLACEHOLDER_DOMAIN
PAPERCLIP_ALLOWED_HOSTNAMES=PLACEHOLDER_DOMAIN

# Replaced on first boot
BETTER_AUTH_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT

# Required for authenticated/public — local Postgres (password set on first boot)
DATABASE_URL=postgres://paperclip:PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT@127.0.0.1:5432/paperclip

# DigitalOcean Serverless Inference (optional):
#   MODEL_ACCESS_KEY    Model access key (Inference > Manage > Model Access Keys)
#   INFERENCE_MODEL     Model id from https://inference.do-ai.run/v1/models
#                       When a router is set, apply stores router:<name> here.
#                       (default: first chat model from live list, else minimax-m2.5)
#   DO_INFERENCE_ROUTER Optional Intelligent Inference Router name → router:<name>
#
# On first boot, 001_onboot reads /etc/environment first, then this file.
# If MODEL_ACCESS_KEY is set, apply configures Inference and skips the SSH wizard.
# Existing OPENAI_API_KEY values are preserved; DO maps to OPENAI_* only when empty.
# Apply also writes PAPERCLIP_OPENCODE_PROVIDERS (provider id digitalocean),
# PAPERCLIP_OPENCODE_SMALL_MODEL, and OPENCODE_ALLOW_ALL_MODELS=true.
# Onboarding then shows a DigitalOcean Inference tile that hires OpenCode on
# digitalocean/<id>. Codex uses the raw id with OPENAI_BASE_URL.
#
# Interactive setup: sudo /etc/setup_wizard.sh
# Re-apply:          /opt/apply-inference-from-env.sh

MODEL_ACCESS_KEY=
INFERENCE_MODEL=
DO_INFERENCE_ROUTER=

# Optional other LLM provider keys (set via droplet env, /opt/paperclip.env, or the UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
