[Unit]
Description=Apply Paperclip Serverless Inference config after cloud-init user-data
After=cloud-init.service paperclip.service
Wants=paperclip.service
ConditionPathExists=!/opt/paperclip/.provider-configured

[Service]
Type=oneshot
ExecStart=/opt/retry-apply-inference-after-cloud-init.sh

[Install]
WantedBy=multi-user.target
