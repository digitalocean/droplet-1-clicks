# DigitalOcean Serverless Inference for DSH Superagent.
# A key set here, in the process environment, or in /etc/environment is applied by
# /opt/dsh-superagent/apply-inference-from-env.sh. Leave these empty to configure
# the key at first login instead.
MODEL_ACCESS_KEY=
INFERENCE_MODEL=
DO_INFERENCE_ROUTER=
