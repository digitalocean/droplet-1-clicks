[Unit]
Description=Apply DSH Superagent Serverless Inference config after cloud-init user-data
After=cloud-init.service
ConditionPathExists=!/var/lib/digitalocean/dsh-superagent-inference-configured

[Service]
Type=oneshot
ExecStart=/opt/dsh-superagent/retry-apply-inference-after-cloud-init.sh

[Install]
WantedBy=multi-user.target
