# OmniRoute 1-Click environment (materialized to /opt/omniroute/.env on install)
#
# After changing secrets or inference settings:
#   /opt/restart-omniroute.sh
#   /opt/apply-inference-from-env.sh

OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest

# Generated on first boot — do not share
INITIAL_PASSWORD=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
JWT_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
API_KEY_SECRET=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT
REDIS_PASSWORD=PLACEHOLDER_WILL_BE_REPLACED_ON_FIRST_BOOT

# Public HTTPS origin (droplet IP or custom domain). Rewritten on first boot.
NEXT_PUBLIC_BASE_URL=https://PLACEHOLDER_DOMAIN
OMNIROUTE_PUBLIC_BASE_URL=https://PLACEHOLDER_DOMAIN
BASE_URL=http://omniroute:20128
LIVE_WS_ALLOWED_ORIGINS=https://PLACEHOLDER_DOMAIN

# Heap ceiling for the Node process (4 GB droplet: leave room for Redis + OS)
OMNIROUTE_MEMORY_MB=2048

# DigitalOcean Serverless Inference (optional):
#   MODEL_ACCESS_KEY    Model access key (Inference > Manage > Model Access Keys)
#   INFERENCE_MODEL     Model id from https://inference.do-ai.run/v1/models
#                       (default: first chat model from live list, else minimax-m2.5)
#   DO_INFERENCE_ROUTER Optional Intelligent Inference Router name → router:<name>
#
# On first boot, 001_onboot reads /etc/environment first, then this file.
# If MODEL_ACCESS_KEY is set, DigitalOcean is configured as the preferred provider
# and the interactive SSH wizard is skipped.
#
# Interactive setup: sudo /etc/setup_wizard.sh

MODEL_ACCESS_KEY=
INFERENCE_MODEL=
DO_INFERENCE_ROUTER=
