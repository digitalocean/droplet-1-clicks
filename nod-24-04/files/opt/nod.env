# Nod 1-Click optional inference env (read on first boot / by apply-inference-from-env.sh)
#
# Pre-configure DigitalOcean Serverless Inference by setting these as droplet
# environment variables at create time, or by editing this file and running:
#   sudo /opt/apply-inference-from-env.sh
#   sudo /opt/restart-nod.sh
#
#   MODEL_ACCESS_KEY     Model access key (Inference > Manage in the control panel)
#                        https://cloud.digitalocean.com/gen-ai/model-access-keys
#   INFERENCE_MODEL      Model id from GET https://inference.do-ai.run/v1/models
#                        If empty, the first chat-capable model from that list is used.
#   DO_INFERENCE_ROUTER  Optional. Name of an Intelligent Inference Router attached
#                        to MODEL_ACCESS_KEY. If set, LLM_MODEL becomes router:<name>.
#
# Nod is configured as an OpenAI-compatible provider:
#   LLM_PROVIDER=compatible
#   OPENAI_COMPATIBLE_BASE_URL=https://inference.do-ai.run/v1
#   OPENAI_COMPATIBLE_API_KEY=<MODEL_ACCESS_KEY>
#   LLM_MODEL=<INFERENCE_MODEL or router:<name>>

MODEL_ACCESS_KEY=
INFERENCE_MODEL=
DO_INFERENCE_ROUTER=
