PLACEHOLDER_DOMAIN {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    # OpenClaw 2.0 requires proxy attribution for Caddy→loopback traffic
    # (proxy_attribution_required). Keep X-Forwarded-* so the gateway can
    # attribute the real client IP via gateway.trustedProxies — do NOT strip
    # those headers or OpenClaw treats the request as direct-local and
    # auto-approves Control UI device pairing (token alone would be enough).
    # Pin 127.0.0.1 (not localhost) so the proxy source is IPv4 loopback.
    # Caddy overwrites X-Forwarded-For with the browser client IP by default.
    reverse_proxy 127.0.0.1:18789
    header X-DO-MARKETPLACE "openclaw"
}
