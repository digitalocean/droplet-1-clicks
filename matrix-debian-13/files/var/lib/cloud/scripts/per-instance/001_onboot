#!/bin/bash
# First boot: write Synapse secrets, then drop the build-time SSH lock.
# The lock is removed on exit so a Postgres failure cannot leave root SSH
# stuck on the "droplet ready" ForceCommand.

set -euo pipefail

unlock_ssh() {
  sed -e '/Match User root/d' \
      -e '/.*ForceCommand.*droplet.*/d' \
      -i /etc/ssh/sshd_config
  systemctl restart ssh || true
}
trap unlock_ssh EXIT

secrets=/root/.matrix-secrets
if [ ! -f "$secrets" ]; then
  synapse_postgres_pass=$(openssl rand -hex 24)
  registration_shared_secret=$(openssl rand -hex 24)
  macaroon_secret_key=$(openssl rand -hex 24)
  cat > "$secrets" <<EOF
synapse_postgres_pass: ${synapse_postgres_pass}
registration_shared_secret: ${registration_shared_secret}
macaroon_secret_key: ${macaroon_secret_key}
EOF
else
  synapse_postgres_pass=$(awk '/^synapse_postgres_pass: / {print $2}' "$secrets")
  registration_shared_secret=$(awk '/^registration_shared_secret: / {print $2}' "$secrets")
  macaroon_secret_key=$(awk '/^macaroon_secret_key: / {print $2}' "$secrets")
fi
chmod 600 "$secrets"

: "${synapse_postgres_pass:?missing synapse postgres password}"
: "${registration_shared_secret:?missing registration shared secret}"
: "${macaroon_secret_key:?missing macaroon secret}"

# Postgres can still be starting when cloud-init reaches this script.
i=0
until sudo -u postgres psql -c "ALTER USER synapse_user PASSWORD '${synapse_postgres_pass}';"; do
  i=$((i + 1))
  if [ "$i" -ge 30 ]; then
    echo "postgres did not accept synapse_user password update" >&2
    exit 1
  fi
  sleep 2
done

sed "s/POSTGRES_PASSWORD/${synapse_postgres_pass}/g" -i /etc/matrix-synapse/homeserver.yaml
sed "s/REGISTRATION_SHARED_SECRET/${registration_shared_secret}/g" -i /etc/matrix-synapse/homeserver.yaml
sed "s/MACAROON_SECRET_KEY/${macaroon_secret_key}/g" -i /etc/matrix-synapse/homeserver.yaml
