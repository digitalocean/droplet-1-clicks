#!/bin/bash

set -e

# Remove the ssh force logout command
sed -e '/Match User root/d' \
    -e '/.*ForceCommand.*droplet.*/d' \
    -i /etc/ssh/sshd_config

systemctl restart ssh

# Get the server's IP address
myip=$(hostname -I | awk '{print$1}')

echo "Generating SSH keys for Coolify localhost management..."

# Generate and authorize SSH key for Coolify server management (unique per droplet).
# Matches Coolify install.sh: comment "coolify", authorize pubkey, chown 9999.
# Follow-up to #509 / MP-9232: keep first-boot authorize, but write trust to
# /etc/ssh/authorized_keys.d/coolify (sshd drop-in), NOT /root/.ssh/authorized_keys
# — Vendor Portal img_check fails if that file is populated after onboot.
SSH_KEY_PATH="/data/coolify/ssh/keys/id.root@host.docker.internal"
COOLIFY_AUTH_KEYS="/etc/ssh/authorized_keys.d/coolify"
mkdir -p "$(dirname "${SSH_KEY_PATH}")"
mkdir -p /root/.ssh /etc/ssh/authorized_keys.d
chmod 700 /root/.ssh
chmod 755 /etc/ssh/authorized_keys.d
touch "${COOLIFY_AUTH_KEYS}"
chmod 600 "${COOLIFY_AUTH_KEYS}"

if [ ! -f "${SSH_KEY_PATH}" ]; then
    ssh-keygen -t ed25519 -a 100 -f "${SSH_KEY_PATH}" -q -N '' -C coolify
    echo "SSH keys generated at ${SSH_KEY_PATH}"
else
    echo "SSH keys already exist, skipping generation"
fi

# Scrub Coolify lines from root authorized_keys (img_check + DO/user keys only there)
if [ -f /root/.ssh/authorized_keys ]; then
    sed -i -E \
        -e '/[[:space:]](root@)?coolify[[:space:]]*$/d' \
        -e '/[[:space:]]cpk:[^[:space:]]+/d' \
        /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
fi

# Authorize current pubkey in Coolify-only keys file
sed -i -E '/[[:space:]](root@)?coolify[[:space:]]*$/d' "${COOLIFY_AUTH_KEYS}"
if [ -f "${SSH_KEY_PATH}.pub" ]; then
    cat "${SSH_KEY_PATH}.pub" >> "${COOLIFY_AUTH_KEYS}"
fi
chown 9999:root "${SSH_KEY_PATH}"
chmod 600 "${SSH_KEY_PATH}"
chmod 600 "${COOLIFY_AUTH_KEYS}"

echo "SSH key authorized for localhost management (${COOLIFY_AUTH_KEYS})."

# One-time notice on first SSH login (localhost already activated above)
cat >> /root/.bashrc <<'EOM'
chmod +x /opt/coolify_localhost_setup.sh
/opt/coolify_localhost_setup.sh
EOM

echo "Generating secure random values for Coolify environment..."

# Generate secure random values for .env file (unique per droplet)
sed -i "s|APP_ID=.*|APP_ID=$(openssl rand -hex 16)|g" /data/coolify/source/.env
sed -i "s|APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32)|g" /data/coolify/source/.env
sed -i "s|DB_PASSWORD=.*|DB_PASSWORD=$(openssl rand -base64 32)|g" /data/coolify/source/.env
sed -i "s|REDIS_PASSWORD=.*|REDIS_PASSWORD=$(openssl rand -base64 32)|g" /data/coolify/source/.env
sed -i "s|PUSHER_APP_ID=.*|PUSHER_APP_ID=$(openssl rand -hex 32)|g" /data/coolify/source/.env
sed -i "s|PUSHER_APP_KEY=.*|PUSHER_APP_KEY=$(openssl rand -hex 32)|g" /data/coolify/source/.env
sed -i "s|PUSHER_APP_SECRET=.*|PUSHER_APP_SECRET=$(openssl rand -hex 32)|g" /data/coolify/source/.env

echo "Environment variables configured with unique secure values."

# Reapply proper permissions after key generation
chown -R 9999:root /data/coolify
chmod -R 700 /data/coolify
# Private key must stay readable by Coolify (uid 9999)
chown 9999:root "${SSH_KEY_PATH}"
chmod 600 "${SSH_KEY_PATH}"

echo "Permissions reapplied."

# Start Coolify via systemd so the unit is active (RemainAfterExit oneshot)
echo "Starting Coolify for the first time..."
systemctl daemon-reload
systemctl enable --now coolify.service

# Wait for Coolify health + SSH key reseed (PopulateSshKeysDirectorySeeder
# deletes id.root@host.docker.internal and writes ssh_key@<uuid>)
echo "Waiting for Coolify to initialize..."
for i in $(seq 1 60); do
    if curl -sf --connect-timeout 2 http://127.0.0.1:8000/api/health >/dev/null 2>&1; then
        echo "Coolify health endpoint is up."
        break
    fi
    sleep 5
done

# Give seeders a moment to rewrite keys, then sync trust for onboarding
sleep 10
if ls /data/coolify/ssh/keys/ssh_key@* >/dev/null 2>&1 || [ -f "${SSH_KEY_PATH}" ]; then
    echo "Coolify SSH keys present; syncing authorized_keys and legacy key path..."
else
    echo "Waiting for Coolify to write SSH keys..."
    for i in $(seq 1 24); do
        if ls /data/coolify/ssh/keys/ssh_key@* >/dev/null 2>&1 || [ -f "${SSH_KEY_PATH}" ]; then
            break
        fi
        sleep 5
    done
fi

# Soft-fail: sync errors must not abort first-boot (coolify_info.txt / service markers)
LOCALHOST_SSH_OK=0
chmod +x /opt/coolify-sync-localhost-ssh.sh
if /opt/coolify-sync-localhost-ssh.sh; then
    echo "Coolify localhost SSH sync succeeded."
    LOCALHOST_SSH_OK=1
    touch /root/.coolify_localhost_configured
else
    echo "WARNING: Coolify localhost SSH sync failed (continuing first-boot)."
    echo "  After Coolify is healthy, run: /opt/configure-coolify-localhost.sh"
    rm -f /root/.coolify_localhost_configured
fi

# Check if Coolify is running
if docker compose --env-file /data/coolify/source/.env \
  -f /data/coolify/source/docker-compose.yml \
  -f /data/coolify/source/docker-compose.prod.yml \
  ps | grep -q "coolify"; then
    echo "Coolify started successfully!"
else
    echo "Warning: Coolify may not have started correctly. Check logs with: /opt/coolify-logs.sh"
fi

if [ "${LOCALHOST_SSH_OK}" -eq 1 ]; then
    LOCALHOST_STATUS_LINE="- Localhost SSH trust is configured (port 22)"
    LOCALHOST_REPAIR_LINE="If Validate still fails: /opt/configure-coolify-localhost.sh"
else
    LOCALHOST_STATUS_LINE="- Localhost SSH trust NOT verified yet — run: /opt/configure-coolify-localhost.sh"
    LOCALHOST_REPAIR_LINE="Required: /opt/configure-coolify-localhost.sh then Validate (SSH port 22)"
fi

# Create a file with access information
cat > /root/coolify_info.txt << EOF
================================================================================
Coolify Installation Complete
================================================================================

Access your Coolify instance at:
  http://${myip}:8000

IMPORTANT:
- Create your admin account immediately after accessing the URL above
- If someone else accesses the registration page first, they could gain control
- The first user to register will have full administrative access
${LOCALHOST_STATUS_LINE}
- Coolify UI is :8000 — do NOT set Servers → localhost → SSH port to 8000 or 8080

Management Commands:
  Start Coolify:    /opt/start-coolify.sh
  Stop Coolify:     /opt/stop-coolify.sh
  Restart Coolify:  /opt/restart-coolify.sh
  Update Coolify:   /opt/update-coolify.sh
  View logs:        /opt/coolify-logs.sh
  Check status:     /opt/coolify-status.sh
  Repair localhost: /opt/configure-coolify-localhost.sh

Using systemctl:
  Start:   systemctl start coolify
  Stop:    systemctl stop coolify
  Restart: systemctl restart coolify
  Status:  systemctl status coolify

Configuration:
  Main directory:    /data/coolify
  Configuration:     /data/coolify/source/.env
  Applications:      /data/coolify/applications
  Databases:         /data/coolify/databases
  Backups:           /data/coolify/backups

Firewall Ports:
  22   - SSH (localhost Validate uses this port)
  8000 - Coolify Web Interface
  80   - HTTP
  443  - HTTPS
  6001 - Coolify Realtime
  6002 - Coolify Soketi

${LOCALHOST_REPAIR_LINE}
If Validate times out on port 8080: set Servers → localhost → SSH port to 22,
then re-validate.

For more information, visit: https://coolify.io/docs

================================================================================
EOF

chmod 600 /root/coolify_info.txt

echo "Coolify first-boot initialization complete!"
echo "Access information saved to /root/coolify_info.txt"
