upstream app_server {
    server unix:/home/django/gunicorn.socket fail_timeout=0;
}

server {
    # Bound to loopback only — Caddy terminates public TLS on :80/:443.
    listen 127.0.0.1:8080;
    listen [::1]:8080;

    root /usr/share/nginx/html;
    index index.html index.htm;

    client_max_body_size 4G;
    server_name _;

    keepalive_timeout 5;

    # Your Django project's media files - amend as required
    location /media  {
        alias /home/django/django_project/django_project/media;
    }

    # Django static files, including admin assets collected at first boot.
    location /static/ {
        alias /home/django/django_project/staticfiles/;
    }

    location / {
            # Pass through client / scheme headers from Caddy (do not append loopback).
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Host $host;
            proxy_redirect off;
            proxy_buffering off;

            proxy_pass http://app_server;
    }

}
