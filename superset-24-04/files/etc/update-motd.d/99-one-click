#!/bin/sh
#
# Configured as part of the DigitalOcean 1-Click Image build process

pub=$(curl -fsS --retry 3 --retry-connrefused --max-time 3 \
  http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address 2>/dev/null || true)
myip="${pub:-$(hostname -I | awk '{print $1}')}"
metadata_db=""
if [ -f /var/lib/digitalocean/superset-metadata-db ]; then
  metadata_db=$(tr -d '[:space:]' < /var/lib/digitalocean/superset-metadata-db)
fi

cat <<EOF
********************************************************************************

Welcome to DigitalOcean's Apache Superset Droplet.

Superset is a data exploration and visualization platform. The web UI is
published with Caddy (HTTPS) and the application listens on 127.0.0.1:8088.

Access:
  Web UI:  https://$myip

EOF

if [ -f /var/lib/superset/setup-complete ] && [ -s /etc/superset/admin.password ]; then
  admin_password=$(cat /etc/superset/admin.password)
  cat <<EOF
Sign in:
  Username: admin
  Password: $admin_password

  Password file: /etc/superset/admin.password

EOF
else
  cat <<EOF
Sign in:
  First-boot setup has not finished successfully.
  The admin password is hidden until setup succeeds.
  Log:   /var/log/superset-firstboot.log
  Retry: /var/lib/cloud/scripts/per-instance/001_onboot

EOF
fi

if [ "$metadata_db" = "managed" ] && [ -f /root/.digitalocean_dbaas_credentials ]; then
  # shellcheck disable=SC1091
  . /root/.digitalocean_dbaas_credentials
  meta_line="Metadata database: managed Postgres
    Database: ${db_database}
    Host:     ${db_host}
    Port:     ${db_port}
    Cluster admin: ${db_username}
    Pass:     ${db_password}

  Rotate the Managed Postgres password after first login (control panel or reset).
  Local PostgreSQL has been stopped. The cluster is still installed.
  Starting it only brings the local server back:
  systemctl enable --now postgresql"
elif [ -f /root/.digitalocean_dbaas_credentials ]; then
  meta_line="Metadata database: Superset is still using local PostgreSQL (database superset).
  Managed Postgres credentials were found, but the switch did not finish.
  Add this Droplet's public IP to the cluster Trusted Sources, then re-run:
  /var/lib/cloud/scripts/per-instance/001_onboot"
elif [ "$metadata_db" = "local" ]; then
  meta_line="Metadata database: local PostgreSQL 16 (database superset)"
else
  meta_line="Metadata database: not configured yet"
fi

cat <<EOF
Data:
  $meta_line

  Add analytics databases in the Superset UI (Settings → Database Connections).
  Do not store chart data in the metadata database.

Management:
  Start:    /opt/start-superset.sh
  Stop:     /opt/stop-superset.sh
  Restart:  /opt/restart-superset.sh
  Status:   /opt/status-superset.sh
  Update:   /opt/update-superset.sh [version|--list|--rollback]
  Domain:   /opt/setup-superset-domain.sh

  systemctl {start|stop|restart|status} superset
  journalctl -u superset -f

Marketplace: https://marketplace.digitalocean.com/apps/apache-superset
Docs: https://superset.apache.org/admin-docs/installation/docker-builds/

********************************************************************************
To delete this message of the day: rm -rf $(readlink -f "${0}")
EOF
