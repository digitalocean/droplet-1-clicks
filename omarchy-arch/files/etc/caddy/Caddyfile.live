PLACEHOLDER_DOMAIN {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>headers>Authorization regexp .+ REDACTED
            }
        }
    }
    basic_auth {
        omarchy PLACEHOLDER_HASH
    }
    redir / /vnc.html?autoconnect=true&resize=scale
    reverse_proxy 127.0.0.1:6080
    header X-DO-MARKETPLACE "omarchy"
}
