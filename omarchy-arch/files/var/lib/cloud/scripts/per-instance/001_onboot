#!/bin/bash
#
# Per-instance first-boot configuration.
#
# The `arch` user must not be passwordless (the desktop lock screen uses it),
# so set a random one. It is stored only as a hash in /etc/shadow and never
# written anywhere else; users set their own with `passwd` (see MOTD).

echo "arch:$(pwgen -s 24 1)" | chpasswd

DROPLET_IP=$(curl -s --max-time 5 http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address || hostname -i | awk '{print $1}')

cat > /etc/motd <<EOM

 ------------------------------------------------------------------
  Omarchy on DigitalOcean
 ------------------------------------------------------------------
  See the desktop in your browser (from your local machine):

    1. ssh -N -L 6080:localhost:6080 arch@${DROPLET_IP}
    2. open http://localhost:6080/vnc.html

  Desktop basics:  Super+K = shortcut cheatsheet
                   Super+Return = terminal, Super+Space = launcher

  To lock/unlock the desktop you need a password for user 'arch'.
  None is set up front. Choose your own by running:  passwd
  Update Omarchy from a desktop terminal:  omarchy-update
 ------------------------------------------------------------------

EOM
