#!/bin/bash
#
# Per-instance first-boot configuration.
# The arch user must not keep the build password; set a random one. It is
# stored only as a hash in /etc/shadow; the setup assistant replaces it with
# the user's choice on first login.

echo "arch:$(pwgen -s 24 1)" | chpasswd
# The ISO autoinstall gives root the build password (cidata root_enc_password);
# lock it: console/SSH root logins are never needed (arch has NOPASSWD sudo)
passwd -l root >/dev/null

# Droplet IP via metadata, with retry (network may still be settling) and a
# private-IP fallback so a broken metadata call cannot leave the MOTD blank.
meta() { curl -fsS --retry 10 --retry-connrefused --max-time 2 "$1"; }
DROPLET_PUBLIC_IP="$(meta http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address 2>/dev/null || true)"
DROPLET_PRIVATE_IP="$(hostname -I | awk '{print $1}')"
DROPLET_IP="${DROPLET_PUBLIC_IP:-$DROPLET_PRIVATE_IP}"

# Per-droplet TLS keypair for hypr-rdp. Generated here rather than baked into
# the image on purpose: a key shipped in the snapshot would be the same key on
# every droplet created from it, so anyone with the image could decrypt anyone
# else's session. Self-signed either way, since a public CA will not certify an
# IP address for RDP; clients prompt once to trust it.
#
# Root-owned, group arch: hypr-rdp runs as arch and only reads these.
install -d -m 750 -o root -g arch /etc/hypr-rdp
# Both halves are checked. Testing only the certificate would skip regeneration
# on a droplet that somehow kept the cert but lost the key, leaving a server
# that can never start and an error that points at the wrong file.
if [ ! -s /etc/hypr-rdp/tls.crt ] || [ ! -s /etc/hypr-rdp/tls.key ]; then
  # Errors are left on stderr for cloud-init to capture. Swallowing them meant
  # a failure here surfaced much later as the setup assistant complaining that
  # "first boot may not have finished", which is not the same problem.
  if openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
       -keyout /etc/hypr-rdp/tls.key -out /etc/hypr-rdp/tls.crt \
       -subj "/CN=${DROPLET_IP}" \
       -addext "subjectAltName=IP:${DROPLET_IP}" >/dev/null; then
    chown root:arch /etc/hypr-rdp/tls.key /etc/hypr-rdp/tls.crt
    chmod 640 /etc/hypr-rdp/tls.key
    chmod 644 /etc/hypr-rdp/tls.crt
  else
    echo "ERROR: could not generate the hypr-rdp TLS keypair; the remote desktop will not start" >&2
  fi
fi

cat > /etc/motd <<EOM

 ------------------------------------------------------------------
  Omarchy on DigitalOcean
 ------------------------------------------------------------------
  Desktop over RDP:  ${DROPLET_IP}:3389   (user: omarchy)

  Connect with any RDP client: Windows App / Microsoft Remote
  Desktop on macOS and Windows, Remmina or FreeRDP on Linux.

  The remote desktop is OFF until you set a password, and the
  password is held in memory only, never written to disk, so every
  reboot switches it off again. Turn it on from this console or
  over SSH with:
      omarchy-rdp-password

  Prefer no public endpoint? Put this in /etc/hypr-rdp/options:
      BIND="127.0.0.1:3389"
  then 'systemctl --user restart hypr-rdp', drop the firewall rule
  with 'sudo ufw delete limit 3389/tcp', and tunnel instead:
      ssh -N -L 3389:localhost:3389 arch@${DROPLET_IP}

  Desktop basics:  Super+K or Alt+K = shortcut cheatsheet
  Update Omarchy and system packages:  omarchy-update -y
 ------------------------------------------------------------------

EOM
