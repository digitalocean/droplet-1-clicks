#!/bin/bash
#
# First boot: SSH baseline, then secure the Droplet automatically when user data
# carries TAILSCALE_AUTHKEY and/or CLOUDFLARE_TUNNEL_TOKEN.

set -uo pipefail

STATE_DIR=/var/lib/hardened-droplet
install -d -m 0700 "$STATE_DIR"
[ -e /var/log/hardened-droplet.log ] || install -m 0600 /dev/null /var/log/hardened-droplet.log
exec > >(tee -a /var/log/hardened-droplet.log) 2>&1
echo "$(date -Is) first boot"

################################
## SSH baseline
################################
if [ -s /root/.ssh/authorized_keys ]; then
  install -m 0644 /root/.ssh/authorized_keys /etc/ssh/authorized_keys.d/agent
  install -m 0644 /etc/hardened-droplet/sshd-hardening.conf /etc/ssh/sshd_config.d/10-hardened-droplet.conf
else
  echo "No SSH keys were added at create time; leaving password login enabled."
fi

install -m 0644 /etc/hardened-droplet/AGENTS.md /root/AGENTS.md
install -m 0644 -o agent -g agent /etc/hardened-droplet/AGENTS.md /home/agent/AGENTS.md

# Remove the ssh force logout command
sed -e '/Match User root/d' \
    -e '/.*ForceCommand.*droplet.*/d' \
    -i /etc/ssh/sshd_config

# ssh is socket-activated on 24.04, so /run/sshd may not exist yet and sshd -t
# would fail for that reason alone.
install -d -m 0755 /run/sshd
sshd -t || rm -f /etc/ssh/sshd_config.d/10-hardened-droplet.conf
systemctl restart ssh

ufw default deny incoming
ufw default allow outgoing
ufw limit 22/tcp
ufw --force enable

################################
## Optional setup from user data
################################
user_data=$(curl -fsS --retry 5 --retry-connrefused --max-time 5 \
  http://169.254.169.254/metadata/v1/user-data 2>/dev/null || true)

ud_value() {
  printf '%s\n' "$user_data" \
    | tr -d '\r' \
    | sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?$1=[\"']?([^\"'[:space:]#]+)[\"']?[[:space:]]*(#.*)?$/\2/p" \
    | head -n1
}

ts_key=$(ud_value TAILSCALE_AUTHKEY)
cf_token=$(ud_value CLOUDFLARE_TUNNEL_TOKEN)
close_ssh=$(ud_value HARDENED_CLOSE_SSH)
unset user_data

secret_file() { local f; f=$(mktemp); printf '%s' "$1" >"$f"; echo "$f"; }

if [ -n "$ts_key" ]; then
  echo "TAILSCALE_AUTHKEY found in user data; connecting to Tailscale."
  f=$(secret_file "$ts_key")
  if hardened connect --auth-key-file "$f" --timeout 120s; then
    case "${close_ssh,,}" in
      no|false|0) close_ssh=no ;;
      *) close_ssh=yes ;;
    esac
    if [ "$close_ssh" = yes ]; then
      hardened close-ssh --yes \
        || echo "Closing port 22 failed; public SSH stays open." >"$STATE_DIR/last-error"
    fi
  else
    echo "Tailscale did not connect at first boot; public SSH stays open. Run: hardened setup" \
      >"$STATE_DIR/last-error"
  fi
  rm -f "$f"
fi

if [ -n "$cf_token" ]; then
  echo "CLOUDFLARE_TUNNEL_TOKEN found in user data; starting the tunnel."
  f=$(secret_file "$cf_token")
  if hardened tunnel --token-file "$f"; then
    hardened welcome on || true
  else
    echo "Cloudflare Tunnel did not start at first boot. Run: hardened tunnel" >>"$STATE_DIR/last-error"
  fi
  rm -f "$f"
fi
unset ts_key cf_token

################################
## One-time wizard on first interactive login
################################
if [ ! -e "$STATE_DIR/wizard-done" ] && ! grep -q 'setup_wizard.sh' /root/.bashrc 2>/dev/null; then
  cat >>/root/.bashrc <<'EOM'

# hardened-droplet: one-time setup wizard (interactive terminals only)
if [ -t 0 ] && [ -t 1 ] && [ ! -e /var/lib/hardened-droplet/wizard-done ] && [ -x /etc/setup_wizard.sh ]; then
  /etc/setup_wizard.sh
fi
EOM
fi

echo "$(date -Is) first boot done"
